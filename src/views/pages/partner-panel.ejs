      </div>
    </form>
  </div>
</div>
<% } %>

<script src="/socket.io/socket.io.js"></script>
<script>
  // Initialize Socket.io Client
  const socket = typeof io !== 'undefined' ? io() : null;
  let activePartnerChatRoomId = null;
  let activePartnerChatCustomerName = null;

  if (socket) {
    socket.on('message_history', (history) => {
      const stream = document.getElementById('partner-chat-messages');
      stream.innerHTML = '';
      if (history && history.length > 0) {
        history.forEach(msg => appendMessageToStream(msg));
      } else {
        stream.innerHTML = `
          <div class="flex items-center justify-center h-full text-slate-400 text-xs italic">
            No hay mensajes en esta conversación. ¡Saluda al cliente para iniciar la conversación!
          </div>
        `;
      }
    });

    socket.on('new_message', (msg) => {
      // Update sidebar latest message content
      const msgListEl = document.getElementById('chat-list-msg-' + msg.roomId);
      if (msgListEl) {
        msgListEl.innerText = msg.text;
      }

      if (msg.roomId === activePartnerChatRoomId) {
        // Remove empty placeholder text if present
        const stream = document.getElementById('partner-chat-messages');
        if (stream.querySelector('.italic')) {
          stream.innerHTML = '';
        }
        appendMessageToStream(msg);
      } else {
        // Show unread indicator
        const unreadDot = document.getElementById('chat-tab-unread');
        if (unreadDot) unreadDot.classList.remove('hidden');
        
        // Add indicator to the specific chat list item
        const chatBtn = document.getElementById('chat-list-btn-' + msg.roomId);
        if (chatBtn) {
          chatBtn.classList.add('bg-brand-50/10');
        }
      }
    });
  }

  function escapeHtml(text) {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function appendMessageToStream(msg) {
    const stream = document.getElementById('partner-chat-messages');
    if (!stream) return;
    const isMe = msg.senderType === 'partner';
    
    const div = document.createElement('div');
    div.className = `flex ${isMe ? 'justify-end' : 'justify-start'} w-full`;
    
    const timeStr = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    div.innerHTML = `
      <div class="max-w-[70%] space-y-1">
        <div class="px-4 py-2.5 rounded-2xl text-xs font-medium leading-relaxed ${
          isMe 
            ? 'bg-brand-600 text-white rounded-tr-none' 
            : 'bg-slate-100 text-slate-800 rounded-tl-none border border-slate-150'
        }">
          ${escapeHtml(msg.text)}
        </div>
        <span class="block text-[9px] text-slate-400 ${isMe ? 'text-right' : 'text-left'}">${timeStr}</span>
      </div>
    `;
    
    stream.appendChild(div);
    stream.scrollTop = stream.scrollHeight;
  }

  function selectPartnerChat(roomId, userName) {
    activePartnerChatRoomId = roomId;
    activePartnerChatCustomerName = userName;

    // Reset highlighting on left sidebar
    document.querySelectorAll('.chat-list-btn').forEach(btn => {
      btn.classList.remove('border-brand-650', 'bg-slate-100/40', 'bg-brand-50/10');
    });

    // Highlight selected conversation
    const activeBtn = document.getElementById('chat-list-btn-' + roomId);
    if (activeBtn) {
      activeBtn.classList.add('border-brand-650', 'bg-slate-100/40');
    }

    // Set Header info
    document.getElementById('partner-chat-avatar-text').innerText = userName ? userName.charAt(0).toUpperCase() : 'C';
    document.getElementById('partner-chat-title-name').innerText = userName;

    // Switch container displays
    document.getElementById('partner-chat-placeholder').classList.add('hidden');
    document.getElementById('partner-chat-active-container').classList.remove('hidden');

    // Toggle mobile views
    const sidebar = document.getElementById('partner-chat-sidebar');
    const win = document.getElementById('partner-chat-window');
    if (sidebar && win) {
      sidebar.classList.add('hidden');
      sidebar.classList.remove('flex');
      sidebar.classList.add('md:flex');
      win.classList.remove('hidden');
      win.classList.add('flex');
    }

    // Join room & fetch history
    if (socket) {
      socket.emit('join_room', { roomId });
    }
  }

  function backToChatList() {
    activePartnerChatRoomId = null;
    activePartnerChatCustomerName = null;

    // Toggle mobile views back to sidebar
    const sidebar = document.getElementById('partner-chat-sidebar');
    const win = document.getElementById('partner-chat-window');
    if (sidebar && win) {
      sidebar.classList.remove('hidden');
      sidebar.classList.add('flex');
      win.classList.add('hidden');
      win.classList.remove('flex');
      win.classList.add('md:flex');
    }
  }

  function sendPartnerChatMessage(event) {
    if (event) event.preventDefault();

    const input = document.getElementById('partner-chat-input');
    const text = input.value.trim();
    if (!text || !activePartnerChatRoomId) return;

    if (socket) {
      socket.emit('send_message', { roomId: activePartnerChatRoomId, text });
      input.value = '';
    }
  }

  function switchTab(tabId, buttonElement) {
    if (tabId === 'chat-tab') {
      // Clear tab unread dot
      const unreadDot = document.getElementById('chat-tab-unread');
      if (unreadDot) unreadDot.classList.add('hidden');
    }
    
    // Hide all panels
    const panels = document.querySelectorAll('.tab-panel');
    panels.forEach(p => p.classList.add('hidden'));

    // Show selected panel
    document.getElementById(tabId).classList.remove('hidden');

    // Reset button states
    const buttons = document.querySelectorAll('.tab-btn');
    buttons.forEach(btn => {
      btn.classList.remove('border-brand-650', 'text-brand-650', 'font-bold');
      btn.classList.add('border-transparent', 'text-slate-400');
    });

    // Highlight clicked button
    buttonElement.classList.remove('border-transparent', 'text-slate-400');
    buttonElement.classList.add('border-brand-650', 'text-brand-650', 'font-bold');

    if (tabId === 'accounting-tab') {
      if (typeof initUpdateMap === 'function') {
        setTimeout(initUpdateMap, 150);
      }
      if (typeof initBranchMap === 'function') {
        setTimeout(initBranchMap, 150);
      }
    }
  }

  function filterPartnerProducts() {
    const searchVal = document.getElementById('partner-search-input').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.product-row');
    
    rows.forEach(row => {
      const title = row.getAttribute('data-title') || '';
      if (title.includes(searchVal)) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  function filterPartnerOrders() {
    const searchVal = document.getElementById('partner-orders-search').value.toLowerCase().trim();
    const rows = document.querySelectorAll('.order-row');
    
    rows.forEach(row => {
      const id = row.getAttribute('data-id') || '';
      const client = row.getAttribute('data-client') || '';
      if (id.includes(searchVal) || client.includes(searchVal)) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  function triggerEditProduct(button) {
    const id = button.getAttribute('data-id');
    const title = button.getAttribute('data-title');
    const description = button.getAttribute('data-description');
    const categoryId = button.getAttribute('data-category');
    const locationId = button.getAttribute('data-location') || '';
    
    const modal = document.getElementById('edit-partner-product-modal');
    const card = document.getElementById('edit-modal-card');
    const form = document.getElementById('edit-partner-product-form');
    
    form.action = `/partner/products/${id}/edit`;
    document.getElementById('edit-title').value = title;
    document.getElementById('edit-description').value = description || '';
    document.getElementById('edit-category').value = categoryId || '';
    document.getElementById('edit-location').value = locationId;
    
    modal.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeEditModal() {
    const modal = document.getElementById('edit-partner-product-modal');
    const card = document.getElementById('edit-modal-card');
    
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 150);
  }


  function calculateCommission(inputId, commissionId, netId, previewId) {
    const input = document.getElementById(inputId);
    const commissionEl = document.getElementById(commissionId);
    const netEl = document.getElementById(netId);
    const previewEl = document.getElementById(previewId);
    
    const value = parseFloat(input.value);
    if (!isNaN(value) && value > 0) {
      const commission = value * 0.05;
      const net = value * 0.95;
      commissionEl.textContent = `$${commission.toFixed(2)}`;
      netEl.textContent = `$${net.toFixed(2)}`;
      previewEl.classList.remove('hidden');
    } else {
      previewEl.classList.add('hidden');
    }
  }

  let setupMap;
  let setupMarker;

  function initSetupMap() {
    const setupMapEl = document.getElementById('partner-setup-map');
    if (!setupMapEl) return;

    // Default location (center of Argentina: Buenos Aires Obelisco)
    const defaultPos = { lat: -34.603722, lng: -58.381592 };
    
    setupMap = new google.maps.Map(setupMapEl, {
      center: defaultPos,
      zoom: 12,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true
    });
    
    setupMarker = new google.maps.Marker({
      position: defaultPos,
      map: setupMap,
      draggable: true,
      animation: google.maps.Animation.DROP
    });
    
    // Update Hidden inputs initially
    const latField = document.getElementById('setup-lat');
    const lngField = document.getElementById('setup-lng');
    if (latField && lngField) {
      latField.value = defaultPos.lat;
      lngField.value = defaultPos.lng;
    }
    
    // Drag event
    google.maps.event.addListener(setupMarker, 'dragend', function() {
      const pos = setupMarker.getPosition();
      if (latField && lngField) {
        latField.value = pos.lat();
        lngField.value = pos.lng();
      }
    });
    
    // Click on map event
    setupMap.addListener('click', function(e) {
      const clickedPos = e.latLng;
      setupMarker.setPosition(clickedPos);
      if (latField && lngField) {
        latField.value = clickedPos.lat();
        lngField.value = clickedPos.lng();
      }
    });
    
    // Geolocation to center map automatically
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(position) {
        const userPos = {
          lat: position.coords.latitude,
          lng: position.coords.longitude
        };
        setupMap.setCenter(userPos);
        setupMarker.setPosition(userPos);
        if (latField && lngField) {
          latField.value = userPos.lat;
          lngField.value = userPos.lng;
        }
      });
    }

    // Google Places Autocomplete
    const addressInput = document.getElementById('address');
    if (addressInput) {
      const autocomplete = new google.maps.places.Autocomplete(addressInput, {
        types: ['geocode', 'establishment'],
        componentRestrictions: { country: 'AR' }
      });
      
      autocomplete.addListener('place_changed', function() {
        const place = autocomplete.getPlace();
        if (!place.geometry || !place.geometry.location) {
          return;
        }
        
        setupMap.setCenter(place.geometry.location);
        setupMap.setZoom(17);
        setupMarker.setPosition(place.geometry.location);
        
        if (latField && lngField) {
          latField.value = place.geometry.location.lat();
          lngField.value = place.geometry.location.lng();
        }
      });
    }
  }

  let updateMap;
  let updateMarker;

  function initUpdateMap() {
    const latInput = document.getElementById('update-lat');
    const lngInput = document.getElementById('update-lng');
    const updateMapEl = document.getElementById('partner-update-map');
    if (!latInput || !lngInput || !updateMapEl) return;

    const latVal = parseFloat(latInput.value) || -34.603722;
    const lngVal = parseFloat(lngInput.value) || -58.381592;
    const currentPos = { lat: latVal, lng: lngVal };

    updateMap = new google.maps.Map(updateMapEl, {
      center: currentPos,
      zoom: 13,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true
    });

    updateMarker = new google.maps.Marker({
      position: currentPos,
      map: updateMap,
      draggable: true,
      animation: google.maps.Animation.DROP
    });

    // Drag event
    google.maps.event.addListener(updateMarker, 'dragend', function() {
      const pos = updateMarker.getPosition();
      latInput.value = pos.lat();
      lngInput.value = pos.lng();
    });

    // Click on map event
    updateMap.addListener('click', function(e) {
      const clickedPos = e.latLng;
      updateMarker.setPosition(clickedPos);
      latInput.value = clickedPos.lat();
      lngInput.value = clickedPos.lng();
    });

    // Google Places Autocomplete for updates
    const updateAddressInput = document.getElementById('update-address');
    if (updateAddressInput) {
      const updateAutocomplete = new google.maps.places.Autocomplete(updateAddressInput, {
        types: ['geocode', 'establishment'],
        componentRestrictions: { country: 'AR' }
      });
      
      updateAutocomplete.addListener('place_changed', function() {
        const place = updateAutocomplete.getPlace();
        if (!place.geometry || !place.geometry.location) {
          return;
        }
        
        updateMap.setCenter(place.geometry.location);
        updateMap.setZoom(17);
        updateMarker.setPosition(place.geometry.location);
        
        latInput.value = place.geometry.location.lat();
        lngInput.value = place.geometry.location.lng();
      });
    }
  }

  let branchMap;
  let branchMarker;

  function initBranchMap() {
    const latInput = document.getElementById('loc-lat');
    const lngInput = document.getElementById('loc-lng');
    const branchMapEl = document.getElementById('branch-new-map');
    if (!latInput || !lngInput || !branchMapEl) return;

    const defaultLat = parseFloat(document.getElementById('update-lat')?.value) || -34.603722;
    const defaultLng = parseFloat(document.getElementById('update-lng')?.value) || -58.381592;
    const currentPos = { lat: defaultLat, lng: defaultLng };

    // Set initial values if they are empty
    if (!latInput.value) latInput.value = defaultLat;
    if (!lngInput.value) lngInput.value = defaultLng;

    branchMap = new google.maps.Map(branchMapEl, {
      center: currentPos,
      zoom: 13,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: true
    });

    branchMarker = new google.maps.Marker({
      position: currentPos,
      map: branchMap,
      draggable: true,
      animation: google.maps.Animation.DROP
    });

    // Drag event
    google.maps.event.addListener(branchMarker, 'dragend', function() {
      const pos = branchMarker.getPosition();
      latInput.value = pos.lat();
      lngInput.value = pos.lng();
    });

    // Click on map event
    branchMap.addListener('click', function(e) {
      const clickedPos = e.latLng;
      branchMarker.setPosition(clickedPos);
      latInput.value = clickedPos.lat();
      lngInput.value = clickedPos.lng();
    });

    // Google Places Autocomplete for branch address
    const branchAddressInput = document.getElementById('loc-address');
    if (branchAddressInput) {
      const branchAutocomplete = new google.maps.places.Autocomplete(branchAddressInput, {
        types: ['geocode', 'establishment'],
        componentRestrictions: { country: 'AR' }
      });
      
      branchAutocomplete.addListener('place_changed', function() {
        const place = branchAutocomplete.getPlace();
        if (!place.geometry || !place.geometry.location) {
          return;
        }
        
        branchMap.setCenter(place.geometry.location);
        branchMap.setZoom(17);
        branchMarker.setPosition(place.geometry.location);
        
        latInput.value = place.geometry.location.lat();
        lngInput.value = place.geometry.location.lng();
      });
    }
  }

  function previewProfileLogo(event) {
    const reader = new FileReader();
    reader.onload = function() {
      const output = document.getElementById('profile-logo-preview');
      output.src = reader.result;
    }
    reader.readAsDataURL(event.target.files[0]);
  }

  document.addEventListener('DOMContentLoaded', function() {
    const profileForm = document.querySelector('form[action="/partner/profile"]');
    if (profileForm) {
      profileForm.addEventListener('submit', function(e) {
        const newPass = document.getElementById('profile-password').value;
        const confirmPass = document.getElementById('profile-password-confirm').value;
        if (newPass || confirmPass) {
          if (newPass !== confirmPass) {
            e.preventDefault();
            alert('Las nuevas contraseñas no coinciden. Por favor, verifícalas.');
          }
        }
      });
    }
  });

  function initMaps() {
    initSetupMap();
    const updateMapEl = document.getElementById('partner-update-map');
    if (updateMapEl && updateMapEl.offsetParent !== null) {
      initUpdateMap();
    }
    const branchMapEl = document.getElementById('branch-new-map');
    if (branchMapEl && branchMapEl.offsetParent !== null) {
      initBranchMap();
    }
  }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCBMrNLZp5utwO_ecNIxd2srSxU_LWE2OA&libraries=places&callback=initMaps" async defer></script>

