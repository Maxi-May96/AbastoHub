      <div>
        <label for="edit-description" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Descripción</label>
        <textarea id="edit-description" name="description" rows="4"
          class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium resize-none"></textarea>
      </div>
      
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeEditModal()"
          class="flex-1 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs transition-all text-center">
          Cancelar
