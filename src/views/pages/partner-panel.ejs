<%- include('../partials/header') %>

<% if (!partner.province || !partner.latitude || !partner.longitude) { %>
  <!-- Blocking Setup Location View -->
  <div class="max-w-3xl mx-auto px-4 py-12">
    <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-xl">
      <div class="bg-gradient-to-r from-emerald-800 to-emerald-650 p-8 text-white space-y-3">
        <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center text-white text-3xl">
          <i class="fa-solid fa-map-location-dot"></i>
        </div>
        <h1 class="display-font text-2xl sm:text-3xl font-extrabold tracking-tight">Configura la Ubicación de tu Negocio</h1>
        <p class="text-emerald-100 text-sm">
          Para comenzar a vender en AbastoHub, debes indicar la provincia y la ubicación geográfica exacta en Google Maps de tu sucursal o depósito.
        </p>
      </div>

      <div class="p-6 sm:p-10 space-y-6">
        <!-- Alerts -->
        <% if (locals.success || success) { %>
          <div class="bg-emerald-50 border border-emerald-250 text-emerald-800 px-5 py-4 rounded-2xl text-xs sm:text-sm flex items-center gap-3 shadow-sm mb-4">
            <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
            <span><%= success %></span>
          </div>
        <% } %>

        <% if (locals.error || error) { %>
          <div class="bg-rose-50 border border-rose-250 text-rose-800 px-5 py-4 rounded-2xl text-xs sm:text-sm flex items-center gap-3 shadow-sm mb-4">
            <i class="fa-solid fa-circle-exclamation text-rose-600 text-lg"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/partner/location" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="province" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Provincia (Obligatorio)</label>
              <select id="province" name="province" required
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm font-semibold">
                <option value="" disabled selected>Selecciona tu provincia...</option>
                <option value="Buenos Aires">Buenos Aires</option>
                <option value="CABA">Ciudad Autónoma de Buenos Aires (CABA)</option>
                <option value="Catamarca">Catamarca</option>
                <option value="Chaco">Chaco</option>
                <option value="Chubut">Chubut</option>
                <option value="Córdoba">Córdoba</option>
                <option value="Corrientes">Corrientes</option>
                <option value="Entre Ríos">Entre Ríos</option>
                <option value="Formosa">Formosa</option>
                <option value="Jujuy">Jujuy</option>
                <option value="La Pampa">La Pampa</option>
                <option value="La Rioja">La Rioja</option>
                <option value="Mendoza">Mendoza</option>
                <option value="Misiones">Misiones</option>
                <option value="Neuquén">Neuquén</option>
                <option value="Río Negro">Río Negro</option>
                <option value="Salta">Salta</option>
                <option value="San Juan">San Juan</option>
                <option value="San Luis">San Luis</option>
                <option value="Santa Cruz">Santa Cruz</option>
                <option value="Santa Fe">Santa Fe</option>
                <option value="Santiago del Estero">Santiago del Estero</option>
                <option value="Tierra del Fuego">Tierra del Fuego</option>
                <option value="Tucumán">Tucumán</option>
              </select>
            </div>
            
            <div>
              <label for="address" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Dirección / Localidad (Opcional)</label>
              <input type="text" id="address" name="address" placeholder="Ej. Av. de Mayo 1234, Ramos Mejía"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            </div>
          </div>

          <!-- Map Container -->
          <div class="space-y-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Ubícate en Google Maps (Haz click o arrastra el marcador)</label>
            <div id="partner-setup-map" class="w-full h-80 rounded-2xl border border-slate-250 shadow-inner"></div>
            <p class="text-[10px] text-slate-450"><i class="fa-solid fa-circle-info text-slate-400"></i> Puedes hacer zoom y desplazarte libremente por el mapa para colocar el pin en la posición correcta.</p>
          </div>

          <!-- Hidden coordinates inputs -->
          <input type="hidden" id="setup-lat" name="latitude" required>
          <input type="hidden" id="setup-lng" name="longitude" required>

          <div class="pt-4 border-t border-slate-100 flex justify-between items-center">
            <a href="/partner/logout" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold transition-all">
              Cerrar Sesión
            </a>
            <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs px-6 py-3 rounded-xl transition-all shadow-md">
              Guardar y Continuar <i class="fa-solid fa-chevron-right ml-1"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } else { %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <!-- Header Card -->
  <div class="bg-gradient-to-r from-emerald-800 to-emerald-650 rounded-3xl p-6 sm:p-8 text-white shadow-xl shadow-emerald-950/10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center p-2 border border-white/20">
        <img src="<%= partner.logo %>" alt="<%= partner.name %>" class="w-full h-full object-contain">
      </div>
      <div>
        <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-200 bg-emerald-900/40 px-2.5 py-1 rounded-full border border-emerald-500/20">Portal de Socio</span>
        <h1 class="display-font text-2xl sm:text-3xl font-extrabold tracking-tight mt-1"><%= partner.name %></h1>
        <p class="text-xs text-emerald-100/80 mt-1">Gestiona tu stock y precios. Logística a cargo de AbastoHub.</p>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <a href="/partner/logout" class="px-4 py-2 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/10 text-xs font-bold transition-all flex items-center gap-2">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Cerrar Sesión</span>
      </a>
    </div>
  </div>

  <!-- Alerts -->
  <% if (locals.success || success) { %>
    <div class="bg-emerald-50 border border-emerald-250 text-emerald-800 px-5 py-4 rounded-2xl text-xs sm:text-sm flex items-center gap-3 shadow-sm">
      <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (locals.error || error) { %>
    <div class="bg-rose-50 border border-rose-250 text-rose-800 px-5 py-4 rounded-2xl text-xs sm:text-sm flex items-center gap-3 shadow-sm">
      <i class="fa-solid fa-circle-exclamation text-rose-600 text-lg"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Summary Dashboard Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <div class="bg-white border border-slate-200 rounded-3xl p-5 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-650 flex items-center justify-center text-lg">
        <i class="fa-solid fa-box"></i>
      </div>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Productos</p>
        <p class="text-xl font-extrabold text-slate-800"><%= totalProducts %></p>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-5 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Productos Activos</p>
        <p class="text-xl font-extrabold text-slate-800"><%= activeProducts %></p>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-5 shadow-sm flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-650 flex items-center justify-center text-lg">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Sin Stock (Agotados)</p>
        <p class="text-xl font-extrabold text-slate-800"><%= outOfStockProducts %></p>
      </div>
    </div>
  </div>

  <!-- Navigation Tab Bar -->
  <div class="border-b border-slate-250 flex gap-6 text-sm">
    <button onclick="switchTab('products-list-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-brand-650 text-brand-650 font-bold transition-all">
      <i class="fa-solid fa-list mr-1"></i> Tus Productos
    </button>
    <button onclick="switchTab('orders-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-650 transition-all flex items-center gap-1.5">
      <i class="fa-solid fa-cart-shopping"></i> Pedidos Asignados
      <% if (orders && orders.length > 0) { %>
        <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-750 border border-indigo-150">
          <%= orders.length %>
        </span>
      <% } %>
    </button>
    <button onclick="switchTab('accounting-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-650 transition-all flex items-center gap-1.5">
      <i class="fa-solid fa-calculator"></i> Contabilidad y Retiros
    </button>
    <button onclick="switchTab('drivers-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-650 transition-all flex items-center gap-1.5">
      <i class="fa-solid fa-truck"></i> Conductores
      <% if (partnerDrivers && partnerDrivers.length > 0) { %>
        <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-750 border border-indigo-150">
          <%= partnerDrivers.length %>
        </span>
      <% } %>
    </button>
    <button onclick="switchTab('new-product-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-650 transition-all mr-2">
      <i class="fa-solid fa-circle-plus mr-1"></i> Agregar Producto
    </button>
    <button onclick="switchTab('chat-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-650 transition-all flex items-center gap-1.5">
      <i class="fa-solid fa-comments"></i> Mensajes en Vivo
      <span id="chat-tab-unread" class="hidden inline-flex items-center justify-center px-1.5 py-0.5 rounded-full text-[9px] font-black bg-rose-500 text-white animate-pulse">
        NUEVO
      </span>
    </button>
    <button onclick="switchTab('profile-tab', this)" 
      class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-650 transition-all flex items-center gap-1.5">
      <i class="fa-solid fa-user-gear"></i> Mi Perfil
    </button>
  </div>

  <!-- Panels container -->
  <div class="space-y-6">

    <!-- Tab 1: Products list -->
    <div id="products-list-tab" class="tab-panel space-y-6">
      <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
        
        <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-base font-bold text-slate-800">Catálogo de Productos</h2>
            <p class="text-xs text-slate-400">Edita stock, modifica precios y administra tu catálogo de socio comercial.</p>
          </div>
          
          <div class="relative">
            <input type="text" id="partner-search-input" onkeyup="filterPartnerProducts()" placeholder="Buscar producto..." 
              class="bg-white border border-slate-200 focus:border-brand-500/40 text-slate-800 placeholder-slate-400 px-3.5 py-1.5 pl-8 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs w-48">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[10px]"></i>
          </div>
        </div>

        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-250 text-slate-500 font-semibold text-xs">
                <th class="px-6 py-4">Imagen y Nombre</th>
                <th class="px-6 py-4">Categoría / Unidad</th>
                <th class="px-6 py-4 text-center">Stock</th>
                <th class="px-6 py-4">Precios (Minorista y Mayorista)</th>
                <th class="px-6 py-4 text-center">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100" id="products-table-body">
              <% if (products && products.length > 0) { %>
                <% products.forEach(prod => { %>
                  <tr class="hover:bg-slate-50/30 transition-colors product-row" data-title="<%= prod.title.toLowerCase() %>">
                    
                    <!-- Title & Image -->
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center p-1.5 overflow-hidden flex-shrink-0">
                          <img src="<%= prod.images[0] %>" alt="<%= prod.title %>" class="w-full h-full object-contain">
                        </div>
                        <div>
                          <div class="font-bold text-slate-800 text-xs sm:text-sm"><%= prod.title %></div>
                          <div class="flex items-center gap-1.5 mt-0.5">
                            <% if (prod.location && partner.locations && partner.locations.length > 0) { %>
                              <% 
                                const matchedLoc = partner.locations.find(l => l._id.toString() === prod.location.toString());
                              %>
                              <% if (matchedLoc) { %>
                                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-indigo-50 border border-indigo-100 text-indigo-700 text-[9px] font-bold">
                                  <i class="fa-solid fa-map-pin text-[8px]"></i> <%= matchedLoc.name %>
                                </span>
                              <% } else { %>
                                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-slate-50 border border-slate-200 text-slate-500 text-[9px] font-bold">
                                  Principal
                                </span>
                              <% } %>
                            <% } else { %>
                              <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-slate-50 border border-slate-200 text-slate-500 text-[9px] font-bold">
                                Principal
                              </span>
                            <% } %>
                          </div>
                          <div class="text-[10px] text-slate-400 mt-1 line-clamp-1 max-w-[240px]" title="<%= prod.description %>">
                            <%= prod.description || 'Sin descripción' %>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- Category & Unit -->
                    <td class="px-6 py-4">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                        <%= prod.category ? prod.category.name : 'General' %>
                      </span>
                      <div class="text-[10px] text-slate-400 mt-1">Unidad: <span class="font-semibold text-slate-500"><%= prod.unit %></span></div>
                    </td>

                    <!-- Stock Inline Editor -->
                    <td class="px-6 py-4 text-center">
                      <form action="/partner/products/<%= prod._id %>/stock" method="POST" class="inline-flex items-center justify-center gap-1.5">
                        <input type="number" name="stock" value="<%= prod.stock %>" min="0" required
                          class="w-14 bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-bold px-2 py-1 text-xs text-center outline-none focus:border-brand-500/40 focus:bg-white focus:ring-4 focus:ring-brand-500/10">
                        <button type="submit" class="p-1 rounded-md text-slate-400 hover:text-brand-650 hover:bg-slate-100 transition-all" title="Guardar stock">
                          <i class="fa-solid fa-floppy-disk text-sm"></i>
                        </button>
                      </form>
                    </td>

                    <!-- Pricing Inline Editor -->
                    <td class="px-6 py-4">
                      <form action="/partner/products/<%= prod._id %>/price" method="POST" class="flex flex-col gap-1.5 max-w-[170px]">
                        <div class="flex items-center gap-1">
                          <span class="text-[10px] text-slate-400 font-bold w-10">Minor:</span>
                          <input type="number" name="price" value="<%= prod.price %>" min="0" step="any" required
                            class="w-20 bg-slate-50 border border-slate-200 rounded-lg text-slate-800 font-bold px-1.5 py-0.5 text-xs outline-none focus:border-brand-500/40 focus:bg-white focus:ring-4 focus:ring-brand-500/10">
                        </div>
                        <div class="flex items-center gap-1">
                          <span class="text-[10px] text-slate-400 font-bold w-10">Mayor:</span>
                          <input type="number" name="wholesalePrice" value="<%= prod.wholesalePrice %>" min="0" step="any" required
                            class="w-20 bg-slate-50 border border-slate-200 rounded-lg text-slate-850 font-bold px-1.5 py-0.5 text-xs outline-none focus:border-brand-500/40 focus:bg-white focus:ring-4 focus:ring-brand-500/10">
                          <button type="submit" class="p-1 rounded-md text-slate-400 hover:text-brand-650 hover:bg-slate-100 transition-all ml-1" title="Guardar precios">
                            <i class="fa-solid fa-floppy-disk text-sm"></i>
                          </button>
                        </div>
                      </form>
                    </td>

                    <!-- Actions -->
                    <td class="px-6 py-4 text-center">
                      <div class="flex items-center justify-center gap-2 flex-wrap">
                        <button type="button" 
                                data-id="<%= prod._id %>"
                                data-title="<%= prod.title %>"
                                data-description="<%= prod.description || '' %>"
                                data-category="<%= prod.category ? prod.category._id : '' %>"
                                data-location="<%= prod.location || '' %>"
                                onclick="triggerEditProduct(this)"
                                class="px-3 py-1.5 rounded-xl border border-indigo-100 hover:bg-indigo-50 text-indigo-650 text-xs font-bold transition-all flex items-center gap-1" 
                                title="Editar Nombre, Descripción y Categoría">
                          <i class="fa-solid fa-pen-to-square text-[10px]"></i>Editar
                        </button>
                        
                        <form action="/partner/products/<%= prod._id %>/delete" method="POST" class="inline" onsubmit="return confirm('¿Seguro deseas eliminar este producto por completo?');">
                          <button type="submit" class="px-3 py-1.5 rounded-xl border border-rose-100 hover:bg-rose-50 text-rose-600 text-xs font-bold transition-all">
                            <i class="fa-solid fa-trash-can mr-1"></i>Eliminar
                          </button>
                        </form>
                      </div>
                    </td>

                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="px-6 py-12 text-center text-slate-450">
                    No posees productos en tu catálogo actualmente. ¡Crea el primero usando la pestaña de agregar!
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
    </div>

    <!-- Tab: Orders list -->
    <div id="orders-tab" class="tab-panel hidden space-y-6">
      <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
        
        <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-base font-bold text-slate-800">Pedidos de Clientes</h2>
            <p class="text-xs text-slate-400">Visualiza las órdenes de compra asignadas que contienen tus productos y prepara su inventario.</p>
          </div>
          
          <div class="relative">
            <input type="text" id="partner-orders-search" onkeyup="filterPartnerOrders()" placeholder="Buscar pedido o cliente..." 
              class="bg-white border border-slate-200 focus:border-brand-500/40 text-slate-800 placeholder-slate-400 px-3.5 py-1.5 pl-8 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs w-56">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[10px]"></i>
          </div>
        </div>

        <div class="overflow-x-auto custom-scrollbar">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-250 text-slate-500 font-semibold text-xs">
                <th class="px-6 py-4">Ref. Pedido</th>
                <th class="px-6 py-4">Cliente y Contacto</th>
                <th class="px-6 py-4">Estado Pago/Logística</th>
                <th class="px-6 py-4">Productos Vendidos (Tus Artículos)</th>
                <th class="px-6 py-4">Conductor / Despacho</th>
                <th class="px-6 py-4 text-right">Subtotal Socio</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100" id="orders-table-body">
              <% if (orders && orders.length > 0) { %>
                <% orders.forEach(order => { %>
                  <tr class="hover:bg-slate-50/30 transition-colors order-row text-xs" 
                      data-id="<%= order._id.toString().substring(12).toUpperCase() %>"
                      data-client="<%= (order.shippingDetails?.name || (order.user ? (order.user.name + ' ' + order.user.lastname) : '') || '').toLowerCase() %>">
                    
                    <!-- Order ID & Date -->
                    <td class="px-6 py-4">
                      <div class="font-bold text-slate-800 text-sm">#<%= order._id.toString().substring(12).toUpperCase() %></div>
                      <div class="text-[10px] text-slate-400 mt-1"><%= new Date(order.createdAt).toLocaleString('es-AR') %></div>
                      <div class="mt-2">
                        <a href="/partner/orders/<%= order._id %>/ticket" target="_blank" 
                          class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-lg text-[9px] font-bold border border-rose-150 transition-all"
                          title="Descargar ticket de preparación (Exclusivo de tus artículos)">
                          <i class="fa-solid fa-file-pdf text-[9px] text-rose-600"></i> Ver Ticket PDF
                        </a>
                      </div>
                    </td>

                    <!-- Customer Contact & Delivery Info -->
                    <td class="px-6 py-4 space-y-1">
                      <div class="font-bold text-slate-800"><%= order.shippingDetails?.name || (order.user ? (order.user.name + ' ' + order.user.lastname) : 'Cliente General') %></div>
                      <div class="text-slate-500 flex items-center gap-1.5">
                        <i class="fa-solid fa-phone text-[9px] text-slate-400"></i>
                        <span><%= order.shippingDetails?.phone || (order.user ? order.user.phone : 'N/A') %></span>
                      </div>
                      <div class="text-slate-500 flex items-center gap-1.5 max-w-[220px]">
                        <i class="fa-solid fa-location-dot text-[9px] text-slate-400 flex-shrink-0"></i>
                        <span class="truncate" title="<%= order.shippingDetails?.address %> (<%= order.shippingDetails?.city %>)"><%= order.shippingDetails?.address || 'N/A' %></span>
                      </div>
                      <% if (order.shippingDetails?.notes) { %>
                        <div class="text-[10px] text-slate-400 italic max-w-[220px] truncate" title="<%= order.shippingDetails.notes %>">
                          Obs: "<%= order.shippingDetails.notes %>"
                        </div>
                      <% } %>
                      <% if (order.shippingDetails?.latitude && order.shippingDetails?.longitude) { %>
                        <div class="pt-1">
                          <a href="https://www.google.com/maps/search/?api=1&query=<%= order.shippingDetails.latitude %>,<%= order.shippingDetails.longitude %>" target="_blank"
                            class="inline-flex items-center gap-1 px-2 py-0.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg text-[9px] font-bold border border-indigo-100/50 transition-all">
                            <i class="fa-solid fa-location-crosshairs text-[9px] text-indigo-500"></i> Ver GPS Maps
                          </a>
                        </div>
                      <% } %>
                    </td>

                    <!-- Status Badges -->
                    <td class="px-6 py-4 space-y-2">
                      <!-- Payment Status -->
                      <div>
                        <% if (order.paymentStatus === 'paid') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase">
                            Pago Acreditado
                          </span>
                        <% } else if (order.paymentStatus === 'cancelled') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-rose-50 text-rose-700 border border-rose-100 uppercase">
                            Cancelado
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-50 text-amber-700 border border-amber-100 uppercase">
                            Pago Pendiente
                          </span>
                        <% } %>
                      </div>
                      <% if (order.paymentReceipt) { %>
                        <div>
                          <a href="<%= order.paymentReceipt %>" target="_blank" 
                            class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-lg text-[9px] font-bold border border-emerald-150 transition-all"
                            title="Ver comprobante de pago subido por el cliente">
                            <i class="fa-solid fa-receipt text-[9px] text-emerald-600"></i> Ver Comprobante
                          </a>
                        </div>
                      <% } %>

                      <!-- Logistics Status -->
                      <div>
                        <% if (order.status === 'pending') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-blue-50 text-blue-700 border border-blue-100 uppercase">
                            Pendiente / Nuevo
                          </span>
                        <% } else if (order.status === 'preparing') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-50 text-amber-700 border border-amber-100 uppercase">
                            Preparando pedido
                          </span>
                        <% } else if (order.status === 'shipped') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase">
                            En Camino
                          </span>
                        <% } else if (order.status === 'delivered') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase">
                            Entregado
                          </span>
                        <% } else if (order.status === 'ready_for_pickup') { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase">
                            Listo para Retiro
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-slate-50 text-slate-700 border border-slate-100 uppercase">
                            <%= order.status %>
                          </span>
                        <% } %>
                      </div>
                    </td>

                    <!-- Products -->
                    <td class="px-6 py-4">
                      <div class="space-y-1.5 max-w-sm">
                        <% order.partnerProducts.forEach(item => { %>
                          <div class="flex items-center justify-between gap-4 text-[11px] text-slate-750 bg-slate-50/50 p-1.5 rounded-lg border border-slate-100">
                            <span class="font-semibold truncate max-w-[200px]" title="<%= item.title %>"><%= item.title %></span>
                            <span class="text-slate-400 font-medium text-[10px] flex-shrink-0">
                              <%= item.quantity %> x <%= formatPrice(item.price) %>
                            </span>
                          </div>
                        <% }); %>
                      </div>
                    </td>

                    <!-- Driver / Dispatch -->
                    <td class="px-6 py-4">
                      <% if (order.driverName) { %>
                        <div class="flex items-center gap-2 text-indigo-700 font-bold text-xs bg-indigo-50 border border-indigo-100 px-3 py-2 rounded-xl inline-flex shadow-2xs">
                          <i class="fa-solid fa-truck text-[10px] text-indigo-500"></i>
                          <div>
                            <div class="text-[11px] font-bold text-indigo-900"><%= order.driverName %></div>
                            <div class="text-[9px] text-indigo-500 font-semibold mt-0.5"><%= order.driverVehicle %></div>
                          </div>
                        </div>
                      <% } else { %>
                        <form action="/partner/orders/<%= order._id %>/ship" method="POST" class="inline" onsubmit="return confirm('¿Seguro desea marcar este pedido como en camino?');">
                          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-[10px] px-2.5 py-1.5 rounded-xl transition-all shadow-sm flex items-center gap-1">
                            <i class="fa-solid fa-truck-fast text-[9px]"></i> Poner en Camino
                          </button>
                        </form>
                      <% } %>
                    </td>

                    <!-- Subtotal Partner -->
                    <td class="px-6 py-4 text-right font-extrabold text-slate-800 text-sm">
                      <%= formatPrice(order.partnerSubtotal) %>
                    </td>

                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                    No hay pedidos registrados para tus productos por el momento.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
    </div>

    <!-- Tab: Accounting, Balance, Withdrawals -->
    <div id="accounting-tab" class="tab-panel hidden space-y-6">
      
      <!-- Balance Metrics Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-gradient-to-br from-emerald-50 to-white border border-emerald-200 rounded-3xl p-6 shadow-sm flex items-center gap-4 relative overflow-hidden">
          <div class="absolute -right-4 -bottom-4 text-emerald-150 text-6xl opacity-40 font-bold"><i class="fa-solid fa-wallet"></i></div>
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-lg">
            <i class="fa-solid fa-wallet"></i>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Saldo Disponible</p>
            <p class="text-2xl font-extrabold text-emerald-850"><%= formatPrice(availableBalance) %></p>
            <p class="text-[10px] text-slate-400 mt-0.5">Listo para ser transferido</p>
          </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex items-center gap-4 relative overflow-hidden">
          <div class="absolute -right-4 -bottom-4 text-slate-50 text-6xl opacity-40 font-bold"><i class="fa-solid fa-coins"></i></div>
          <div class="w-12 h-12 rounded-xl bg-slate-50 text-slate-650 flex items-center justify-center text-lg">
            <i class="fa-solid fa-coins"></i>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Facturado</p>
            <p class="text-2xl font-extrabold text-slate-800"><%= formatPrice(totalEarnings) %></p>
            <p class="text-[10px] text-slate-400 mt-0.5">Ingresos por órdenes pagadas</p>
          </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex items-center gap-4 relative overflow-hidden">
          <div class="absolute -right-4 -bottom-4 text-slate-50 text-6xl opacity-40 font-bold"><i class="fa-solid fa-hand-holding-dollar"></i></div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-lg">
            <i class="fa-solid fa-hand-holding-dollar"></i>
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Retiros Solicitados</p>
            <p class="text-2xl font-extrabold text-slate-800"><%= formatPrice(totalApprovedWithdrawals + totalPendingWithdrawals) %></p>
            <p class="text-[10px] text-slate-400 mt-0.5">
              <%= formatPrice(totalPendingWithdrawals) %> pendientes de pago
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: Bank Coordinates & Payout Forms -->
        <div class="lg:col-span-1 space-y-6">
          
          <!-- Bank Details Form -->
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <h3 class="font-bold text-slate-800 text-sm mb-1.5 flex items-center gap-2">
              <i class="fa-solid fa-building-columns text-brand-650"></i>
              Datos de Transferencia
            </h3>
            <p class="text-slate-400 text-[11px] mb-4">Configura tu CBU/CVU y Alias para recibir las transferencias correspondientes a tus ventas.</p>
            
            <form action="/partner/bank-details" method="POST" class="space-y-4">
              <div>
                <label for="bank-name" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Nombre del Banco / Virtual *</label>
                <input type="text" id="bank-name" name="bankName" value="<%= partner.bankName %>" required placeholder="Ej. Banco Galicia, MercadoPago"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
              </div>

              <div>
                <label for="bank-cbu" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">CBU / CVU *</label>
                <input type="text" id="bank-cbu" name="cbu" value="<%= partner.cbu %>" required placeholder="22 dígitos"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold tracking-wider">
              </div>

              <div>
                <label for="bank-alias" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Alias CBU / CVU *</label>
                <input type="text" id="bank-alias" name="alias" value="<%= partner.alias %>" required placeholder="Ej. cooperativa.fruta.mp"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
              </div>

              <button type="submit" class="w-full py-2.5 rounded-xl bg-brand-650 hover:bg-brand-700 text-white font-bold text-xs shadow-sm transition-all text-center">
                Guardar Cuentas Bancarias
              </button>
            </form>
          </div>

          <!-- Monthly Summary Download Form -->
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <h3 class="font-bold text-slate-800 text-sm mb-1.5 flex items-center gap-2">
              <i class="fa-solid fa-file-invoice-dollar text-brand-650"></i>
              Resumen de Cuenta Mensual
            </h3>
            <p class="text-slate-400 text-[11px] mb-4">Exporta un reporte en PDF de tus ventas, cobranzas y retiros procesados en el mes seleccionado.</p>
            
            <form action="/partner/download-summary" method="GET" target="_blank" class="space-y-4">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="summary-month" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Mes</label>
                  <select id="summary-month" name="month" class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
                    <% 
                      const months = [
                        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
                      ];
                      const currentMonth = new Date().getMonth();
                      months.forEach((mName, index) => {
                    %>
                      <option value="<%= index + 1 %>" <%= index === currentMonth ? 'selected' : '' %>><%= mName %></option>
                    <% }); %>
                  </select>
                </div>

                <div>
                  <label for="summary-year" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Año</label>
                  <select id="summary-year" name="year" class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
                    <% 
                      const currentYear = new Date().getFullYear();
                      for (let y = currentYear - 2; y <= currentYear; y++) {
                    %>
                      <option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                  </select>
                </div>
              </div>

              <button type="submit" class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs shadow-sm transition-all text-center flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-file-pdf text-rose-500 text-[13px]"></i> Descargar Resumen PDF
              </button>
            </form>
          </div>

          <!-- Location Details Form -->
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <h3 class="font-bold text-slate-800 text-sm mb-1.5 flex items-center gap-2">
              <i class="fa-solid fa-map-location-dot text-brand-650"></i>
              Ubicación del Negocio
            </h3>
            <p class="text-slate-400 text-[11px] mb-4">Configura la provincia y la ubicación geográfica de tu sucursal para el filtrado de catálogo.</p>
            
            <form action="/partner/location" method="POST" class="space-y-4">
              <div>
                <label for="update-province" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Provincia *</label>
                <select id="update-province" name="province" required
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold font-medium">
                  <option value="" disabled>Selecciona tu provincia...</option>
                  <option value="Buenos Aires" <%= partner.province === 'Buenos Aires' ? 'selected' : '' %>>Buenos Aires</option>
                  <option value="CABA" <%= partner.province === 'CABA' ? 'selected' : '' %>>Ciudad Autónoma de Buenos Aires (CABA)</option>
                  <option value="Catamarca" <%= partner.province === 'Catamarca' ? 'selected' : '' %>>Catamarca</option>
                  <option value="Chaco" <%= partner.province === 'Chaco' ? 'selected' : '' %>>Chaco</option>
                  <option value="Chubut" <%= partner.province === 'Chubut' ? 'selected' : '' %>>Chubut</option>
                  <option value="Córdoba" <%= partner.province === 'Córdoba' ? 'selected' : '' %>>Córdoba</option>
                  <option value="Corrientes" <%= partner.province === 'Corrientes' ? 'selected' : '' %>>Corrientes</option>
                  <option value="Entre Ríos" <%= partner.province === 'Entre Ríos' ? 'selected' : '' %>>Entre Ríos</option>
                  <option value="Formosa" <%= partner.province === 'Formosa' ? 'selected' : '' %>>Formosa</option>
                  <option value="Jujuy" <%= partner.province === 'Jujuy' ? 'selected' : '' %>>Jujuy</option>
                  <option value="La Pampa" <%= partner.province === 'La Pampa' ? 'selected' : '' %>>La Pampa</option>
                  <option value="La Rioja" <%= partner.province === 'La Rioja' ? 'selected' : '' %>>La Rioja</option>
                  <option value="Mendoza" <%= partner.province === 'Mendoza' ? 'selected' : '' %>>Mendoza</option>
                  <option value="Misiones" <%= partner.province === 'Misiones' ? 'selected' : '' %>>Misiones</option>
                  <option value="Neuquén" <%= partner.province === 'Neuquén' ? 'selected' : '' %>>Neuquén</option>
                  <option value="Río Negro" <%= partner.province === 'Río Negro' ? 'selected' : '' %>>Río Negro</option>
                  <option value="Salta" <%= partner.province === 'Salta' ? 'selected' : '' %>>Salta</option>
                  <option value="San Juan" <%= partner.province === 'San Juan' ? 'selected' : '' %>>San Juan</option>
                  <option value="San Luis" <%= partner.province === 'San Luis' ? 'selected' : '' %>>San Luis</option>
                  <option value="Santa Cruz" <%= partner.province === 'Santa Cruz' ? 'selected' : '' %>>Santa Cruz</option>
                  <option value="Santa Fe" <%= partner.province === 'Santa Fe' ? 'selected' : '' %>>Santa Fe</option>
                  <option value="Santiago del Estero" <%= partner.province === 'Santiago del Estero' ? 'selected' : '' %>>Santiago del Estero</option>
                  <option value="Tierra del Fuego" <%= partner.province === 'Tierra del Fuego' ? 'selected' : '' %>>Tierra del Fuego</option>
                  <option value="Tucumán" <%= partner.province === 'Tucumán' ? 'selected' : '' %>>Tucumán</option>
                </select>
              </div>

              <div>
                <label for="update-address" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Dirección / Localidad</label>
                <input type="text" id="update-address" name="address" value="<%= partner.address %>" placeholder="Ej. Av. de Mayo 1234, Ramos Mejía"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
              </div>

              <div class="space-y-1">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Ubicación GPS (Haz click en el mapa para actualizar)</label>
                <div id="partner-update-map" class="w-full h-44 rounded-xl border border-slate-200"></div>
              </div>

              <input type="hidden" id="update-lat" name="latitude" value="<%= partner.latitude %>" required>
              <input type="hidden" id="update-lng" name="longitude" value="<%= partner.longitude %>" required>

              <button type="submit" class="w-full py-2.5 rounded-xl bg-brand-650 hover:bg-brand-700 text-white font-bold text-xs shadow-sm transition-all text-center">
                Actualizar Ubicación
              </button>
            </form>
          </div>

          <!-- Additional Branches / Locations Management -->
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <h3 class="font-bold text-slate-800 text-sm mb-1.5 flex items-center gap-2">
              <i class="fa-solid fa-map-pin text-brand-650"></i>
              Sucursales / Locaciones Adicionales
            </h3>
            <p class="text-slate-400 text-[11px] mb-4">Administra tus sedes adicionales para asociarlas a tus productos en catálogo.</p>

            <!-- List of existing locations -->
            <div class="space-y-3 mb-4">
              <% if (partner.locations && partner.locations.length > 0) { %>
                <% partner.locations.forEach(loc => { %>
                  <div class="p-3 bg-slate-50 border border-slate-200 rounded-2xl flex justify-between items-center gap-3">
                    <div>
                      <p class="font-bold text-slate-800 text-xs"><%= loc.name %></p>
                      <p class="text-[10px] text-slate-500 mt-0.5"><%= loc.address %> - <%= loc.province %></p>
                      <% if (loc.latitude && loc.longitude) { %>
                        <p class="text-[9px] text-slate-400 font-mono mt-0.5"><%= loc.latitude.toFixed(4) %>, <%= loc.longitude.toFixed(4) %></p>
                      <% } %>
                    </div>
                    <form action="/partner/locations/<%= loc._id %>/delete" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar esta sucursal? Los productos asociados volverán a la ubicación principal.');">
                      <button type="submit" class="text-slate-400 hover:text-rose-600 p-1.5 transition-colors">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>
                  </div>
                <% }); %>
              <% } else { %>
                <p class="text-center text-slate-400 text-[11px] py-2 bg-slate-50/50 border border-dashed border-slate-250 rounded-2xl">
                  No tienes sucursales adicionales registradas.
                </p>
              <% } %>
            </div>

            <!-- Form to add new location -->
            <form action="/partner/locations" method="POST" class="space-y-3 pt-3 border-t border-slate-100">
              <p class="font-bold text-slate-700 text-xs mb-1">Nueva Sucursal</p>
              
              <div>
                <label for="loc-name" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-0.5">Nombre / Identificador *</label>
                <input type="text" id="loc-name" name="name" required placeholder="Ej. Sucursal Posadas, Sede Tucumán"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-1.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="loc-province" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-0.5">Provincia *</label>
                  <select id="loc-province" name="province" required
                    class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-3 py-1.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
                    <option value="" disabled selected>Selecciona...</option>
                    <option value="Buenos Aires">Buenos Aires</option>
                    <option value="CABA">CABA</option>
                    <option value="Catamarca">Catamarca</option>
                    <option value="Chaco">Chaco</option>
                    <option value="Chubut">Chubut</option>
                    <option value="Córdoba">Córdoba</option>
                    <option value="Corrientes">Corrientes</option>
                    <option value="Entre Ríos">Entre Ríos</option>
                    <option value="Formosa">Formosa</option>
                    <option value="Jujuy">Jujuy</option>
                    <option value="La Pampa">La Pampa</option>
                    <option value="La Rioja">La Rioja</option>
                    <option value="Mendoza">Mendoza</option>
                    <option value="Misiones">Misiones</option>
                    <option value="Neuquén">Neuquén</option>
                    <option value="Río Negro">Río Negro</option>
                    <option value="Salta">Salta</option>
                    <option value="San Juan">San Juan</option>
                    <option value="San Luis">San Luis</option>
                    <option value="Santa Cruz">Santa Cruz</option>
                    <option value="Santa Fe">Santa Fe</option>
                    <option value="Santiago del Estero">Santiago del Estero</option>
                    <option value="Tierra del Fuego">Tierra del Fuego</option>
                    <option value="Tucumán">Tucumán</option>
                  </select>
                </div>
                <div>
                  <label for="loc-address" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-0.5">Dirección / Localidad *</label>
                  <input type="text" id="loc-address" name="address" required placeholder="Ej. Av. de Mayo 1234, Ramos Mejía"
                    class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-1.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-semibold">
                </div>
              </div>

              <!-- Map for Selecting Branch Location Coordinates -->
              <div class="space-y-1">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Ubicación GPS de la Sucursal (Haz click en el mapa para actualizar)</label>
                <div id="branch-new-map" class="w-full h-44 rounded-xl border border-slate-200"></div>
              </div>

              <input type="hidden" id="loc-lat" name="latitude" required>
              <input type="hidden" id="loc-lng" name="longitude" required>

              <button type="submit" class="w-full py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs shadow-sm transition-all text-center">
                Agregar Sucursal
              </button>
            </form>
          </div>

          <!-- Request Payout Form -->
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <h3 class="font-bold text-slate-800 text-sm mb-1.5 flex items-center gap-2">
              <i class="fa-solid fa-paper-plane text-emerald-600"></i>
              Solicitar Retiro
            </h3>
            <p class="text-slate-400 text-[11px] mb-4">Ingresa el monto que deseas transferir a tu cuenta bancaria. Mínimo $1.</p>
            
            <% if (!partner.alias || !partner.cbu) { %>
              <div class="bg-amber-50 border border-amber-200 text-amber-800 p-3 rounded-xl text-[11px] mb-2">
                <i class="fa-solid fa-triangle-exclamation mr-1 text-amber-600"></i>
                Primero debes configurar y guardar tus datos de transferencia bancaria arriba.
              </div>
            <% } %>

            <form action="/partner/withdraw" method="POST" class="space-y-4">
              <div>
                <label for="withdraw-amount" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Monto a retirar ($) *</label>
                <input type="number" id="withdraw-amount" name="amount" min="1" max="<%= availableBalance %>" required placeholder="Monto" <%= (!partner.alias || !partner.cbu || availableBalance <= 0) ? 'disabled' : '' %>
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-850 placeholder-slate-400 px-3 py-2 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm font-bold">
              </div>

              <button type="submit" <%= (!partner.alias || !partner.cbu || availableBalance <= 0) ? 'disabled' : '' %>
                class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition-all text-center disabled:opacity-50 disabled:cursor-not-allowed">
                Solicitar Transferencia
              </button>
            </form>
          </div>

        </div>

        <!-- Right Column: Withdrawals Logs -->
        <div class="lg:col-span-2 space-y-6">
          <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50">
              <h3 class="font-bold text-slate-800 text-sm">Historial de Retiros</h3>
              <p class="text-slate-450 text-[11px]">Sigue el estado y detalles de tus solicitudes de transferencia y pagos recibidos.</p>
            </div>

            <div class="overflow-x-auto custom-scrollbar">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold">
                    <th class="px-6 py-3.5">Fecha</th>
                    <th class="px-6 py-3.5">Cuenta Destino</th>
                    <th class="px-6 py-3.5">Monto</th>
                    <th class="px-6 py-3.5">Estado</th>
                    <th class="px-6 py-3.5">Notas del Admin</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% if (withdrawals && withdrawals.length > 0) { %>
                    <% withdrawals.forEach(w => { %>
                      <tr class="hover:bg-slate-50/20 transition-colors">
                        <td class="px-6 py-4">
                          <div class="font-semibold text-slate-700"><%= new Date(w.createdAt).toLocaleDateString('es-AR') %></div>
                          <div class="text-[9px] text-slate-400"><%= new Date(w.createdAt).toLocaleTimeString('es-AR', {hour: '2-digit', minute:'2-digit'}) %></div>
                        </td>
                        <td class="px-6 py-4">
                          <div class="font-bold text-slate-800"><%= w.bankName || 'Banco' %></div>
                          <div class="text-[10px] text-slate-455">Alias: <span class="font-mono text-slate-600"><%= w.alias %></span></div>
                          <div class="text-[10px] text-slate-455">CBU: <span class="font-mono text-slate-650"><%= w.cbu %></span></div>
                        </td>
                        <td class="px-6 py-4 font-extrabold text-slate-800 text-sm">
                          <%= formatPrice(w.amount) %>
                        </td>
                        <td class="px-6 py-4">
                          <% if (w.status === 'approved') { %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase">
                              Pagado
                            </span>
                            <% if (w.processedAt) { %>
                              <div class="text-[8px] text-slate-400 mt-1"><%= new Date(w.processedAt).toLocaleDateString('es-AR') %></div>
                            <% } %>
                          <% } else if (w.status === 'rejected') { %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-rose-50 text-rose-700 border border-rose-100 uppercase">
                              Rechazado
                            </span>
                          <% } else { %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-50 text-amber-700 border border-amber-100 uppercase">
                              Pendiente
                            </span>
                          <% } %>
                        </td>
                        <td class="px-6 py-4 text-[10px] text-slate-500 italic max-w-[150px] truncate" title="<%= w.notes %>">
                          <%= w.notes || 'Sin observaciones' %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                        Aún no posees solicitudes de retiro registradas.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

          </div>
        </div>

      </div>

    </div>

    <!-- Tab 2: Create product form -->
    <div id="new-product-tab" class="tab-panel hidden space-y-6">
      <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold text-slate-800 mb-2">Nuevo Producto para tu Catálogo</h2>
        <p class="text-xs text-slate-400 mb-6">El producto estará disponible en el catálogo público una vez guardado. La logística de entregas corre por cuenta de AbastoHub.</p>

        <!-- Notification: 5% Commission Info -->
        <div class="bg-indigo-50 border border-indigo-150 rounded-2xl p-4 flex gap-3 text-xs text-indigo-900 mb-6">
          <div class="text-indigo-600 text-lg mt-0.5">
            <i class="fa-solid fa-circle-info"></i>
          </div>
          <div>
            <span class="font-extrabold uppercase tracking-wider text-[10px] text-indigo-750 block mb-1">Comisión de la Plataforma</span>
            La aplicación cobra una comisión del <strong>5%</strong> por cada compra realizada de tus productos. A continuación puedes ver el desglose en tiempo real de lo que recibirás.
          </div>
        </div>

        <form action="/partner/products" method="POST" enctype="multipart/form-data" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <!-- Title -->
            <div>
              <label for="prod-title" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nombre del Producto *</label>
              <input type="text" id="prod-title" name="title" required placeholder="E.g. Manzana Verde Orgánica"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            </div>

            <!-- Category -->
            <div>
              <label for="prod-category" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Categoría *</label>
              <select id="prod-category" name="categoryId" required
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
                <% categories.forEach(cat => { %>
                  <option value="<%= cat._id %>"><%= cat.name %></option>
                <% }); %>
              </select>
            </div>

            <!-- Location / Branch -->
            <div>
              <label for="prod-location" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Sucursal / Locación</label>
              <select id="prod-location" name="locationId"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm font-semibold">
                <option value="">Ubicación Principal (<%= partner.province %>)</option>
                <% if (partner.locations && partner.locations.length > 0) { %>
                  <option value="all" class="text-brand-650 font-bold bg-brand-50">Todas las Sucursales</option>
                  <% partner.locations.forEach(loc => { %>
                    <option value="<%= loc._id %>"><%= loc.name %> (<%= loc.province %>)</option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <!-- Price Minorista -->
            <div>
              <label for="prod-price" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Precio Minorista *</label>
              <input type="number" id="prod-price" name="price" min="0" step="any" required placeholder="0.00" oninput="calculateCommission('prod-price', 'minorista-comm', 'minorista-net', 'price-commission-preview')"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm font-bold">
              
              <!-- Commission Info -->
              <div id="price-commission-preview" class="text-[10px] text-slate-500 mt-2 hidden space-y-0.5 bg-slate-50 border border-slate-150 p-2 rounded-xl">
                <div>Comisión (5%): <span class="font-bold text-rose-600" id="minorista-comm">$0.00</span></div>
                <div>Recibirás (95%): <span class="font-bold text-emerald-600" id="minorista-net">$0.00</span></div>
              </div>
            </div>

            <!-- Price Mayorista -->
            <div>
              <label for="prod-wholesale" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Precio Mayorista (Opcional)</label>
              <input type="number" id="prod-wholesale" name="wholesalePrice" min="0" step="any" placeholder="Al por mayor" oninput="calculateCommission('prod-wholesale', 'mayorista-comm', 'mayorista-net', 'wholesale-commission-preview')"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm font-bold">
              
              <!-- Commission Info -->
              <div id="wholesale-commission-preview" class="text-[10px] text-slate-500 mt-2 hidden space-y-0.5 bg-slate-50 border border-slate-150 p-2 rounded-xl">
                <div>Comisión (5%): <span class="font-bold text-rose-600" id="mayorista-comm">$0.00</span></div>
                <div>Recibirás (95%): <span class="font-bold text-emerald-600" id="mayorista-net">$0.00</span></div>
              </div>
            </div>

            <!-- Stock -->
            <div>
              <label for="prod-stock" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Stock Inicial *</label>
              <input type="number" id="prod-stock" name="stock" min="0" required placeholder="0"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm font-bold">
            </div>

            <!-- Unit -->
            <div>
              <label for="prod-unit" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Unidad de Medida *</label>
              <input type="text" id="prod-unit" name="unit" required placeholder="E.g. kg, unidad, cajón"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            </div>
          </div>

          <!-- Description -->
          <div>
            <label for="prod-description" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Descripción</label>
            <textarea id="prod-description" name="description" rows="3" placeholder="Escribe detalles del producto, origen o especificaciones..."
              class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm resize-none"></textarea>
          </div>

          <!-- Image Files -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Imágenes del Producto (Max 3)</label>
            <input type="file" name="images" multiple accept="image/*"
              class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-850 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            <span class="text-[10px] text-slate-400 mt-1 block">Selecciona hasta 3 imágenes. Si no se sube ninguna, se usará un marcador predeterminado.</span>
          </div>

          <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
            <button type="reset" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-650 hover:bg-slate-50 text-xs font-bold transition-all">
              Limpiar Campos
            </button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-650 hover:bg-brand-700 text-white text-xs font-bold transition-all shadow-sm">
              Guardar Producto
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Tab 5: Conductores Panel -->
    <div id="drivers-tab" class="tab-panel hidden space-y-6">
      <div class="bg-white border border-slate-200 rounded-3xl p-12 text-center shadow-sm">
        <div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center mx-auto mb-4 text-slate-400">
          <i class="fa-solid fa-clock-rotate-left text-2xl text-slate-400"></i>
        </div>
        <h3 class="display-font text-lg font-bold text-slate-800">Función en Desarrollo</h3>
        <p class="text-xs mt-2 text-slate-500 max-w-sm mx-auto leading-relaxed">
          El ingreso de conductores propios y la autogestión de despachos estarán disponibles en las próximas versiones de la plataforma.
        </p>
      </div>
    </div>

    <!-- Tab: Live Chat / Mensajes en Vivo -->
    <div id="chat-tab" class="tab-panel hidden">
      <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm flex flex-col md:flex-row h-[600px]">
        
        <!-- Left Side: Active Chats Sidebar -->
        <div class="w-full md:w-80 border-r border-slate-150 flex flex-col bg-slate-50/50" id="partner-chat-sidebar">
          <div class="p-4 border-b border-slate-150 bg-white">
            <h3 class="display-font text-sm font-black text-slate-800 flex items-center gap-2">
              <i class="fa-solid fa-comments text-brand-650"></i>
              <span>Conversaciones</span>
            </h3>
            <p class="text-[10px] text-slate-400 mt-1">Chats activos de las últimas 72 horas</p>
          </div>
          
          <div class="flex-1 overflow-y-auto divide-y divide-slate-100" id="partner-chat-list">
            <% if (typeof activeChats !== 'undefined' && activeChats && activeChats.length > 0) { %>
              <% activeChats.forEach((chat, idx) => { %>
                <button type="button" onclick="selectPartnerChat('<%= chat._id %>', '<%= chat.userName %>')"
                  class="w-full text-left p-4 hover:bg-slate-100/70 transition-all flex items-start gap-3 border-l-4 border-transparent chat-list-btn"
                  id="chat-list-btn-<%= chat._id %>">
                  <div class="w-9 h-9 rounded-full bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-xs shrink-0 border border-brand-100 uppercase">
                    <%= chat.userName ? chat.userName.charAt(0) : 'C' %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex justify-between items-baseline mb-0.5">
                      <h4 class="text-xs font-bold text-slate-800 truncate"><%= chat.userName %></h4>
                      <span class="text-[9px] text-slate-400 shrink-0 font-medium">
                        <%= new Date(chat.lastMessageTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-500 truncate" id="chat-list-msg-<%= chat._id %>"><%= chat.lastMessage %></p>
                  </div>
                </button>
              <% }); %>
            <% } else { %>
              <div class="p-8 text-center text-slate-400 space-y-2 mt-12">
                <i class="fa-solid fa-message-slash text-2xl text-slate-350"></i>
                <p class="text-xs font-medium">No tienes chats activos.</p>
                <p class="text-[10px] text-slate-400 max-w-[200px] mx-auto">Cuando un cliente te envíe un mensaje desde un producto, aparecerá aquí.</p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Right Side: Active Chat Window -->
        <div class="flex-1 flex flex-col bg-white hidden md:flex" id="partner-chat-window">
          <!-- Placeholder state -->
          <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400" id="partner-chat-placeholder">
            <div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center text-slate-350 mb-3 border border-slate-100">
              <i class="fa-solid fa-comments text-2xl"></i>
            </div>
            <h4 class="text-sm font-bold text-slate-800">Bandeja de Mensajes</h4>
            <p class="text-xs text-slate-550 max-w-sm mt-1">Selecciona una conversación de la izquierda para comenzar a chatear en tiempo real con el cliente.</p>
          </div>

          <!-- Active state (hidden by default) -->
          <div class="flex-1 flex flex-col hidden h-full" id="partner-chat-active-container">
            <!-- Chat Header -->
            <div class="px-6 py-4 border-b border-slate-150 flex items-center justify-between bg-slate-50/30">
              <div class="flex items-center gap-3">
                <!-- Mobile Back Button -->
                <button type="button" onclick="backToChatList()" class="md:hidden text-slate-500 hover:text-slate-800 p-1.5 rounded-xl hover:bg-slate-100 transition-all flex items-center justify-center">
                  <i class="fa-solid fa-chevron-left text-sm"></i>
                </button>
                
                <div class="w-9 h-9 rounded-full bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-xs border border-brand-100 uppercase" id="partner-chat-avatar-text">
                  C
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-800" id="partner-chat-title-name">Cliente</h4>
                  <span class="text-[9px] text-emerald-600 font-bold flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span> En Línea
                  </span>
                </div>
              </div>
            </div>

            <!-- Messages Stream -->
            <div class="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50/30" id="partner-chat-messages">
              <!-- Dynamically populated messages -->
            </div>

            <!-- Chat Footer Input -->
            <form id="partner-chat-form" onsubmit="sendPartnerChatMessage(event)" class="p-4 border-t border-slate-150 bg-white flex gap-3">
              <input type="text" id="partner-chat-input" placeholder="Escribe un mensaje..." autocomplete="off"
                class="flex-1 bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
              <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-650 hover:bg-brand-700 text-white font-bold text-xs transition-all shadow-md flex items-center gap-1.5 shrink-0">
                <span>Enviar</span>
                <i class="fa-solid fa-paper-plane"></i>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>

    <!-- Tab 7: Mi Perfil -->
    <div id="profile-tab" class="tab-panel hidden space-y-6">
      <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
        <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
          <div>
            <h2 class="text-base font-bold text-slate-800">Mi Perfil Comercial</h2>
            <p class="text-xs text-slate-400">Edita la información de tu comercio, logotipo, descripción y contraseña de acceso.</p>
          </div>
        </div>

        <form action="/partner/profile" method="POST" enctype="multipart/form-data" class="p-6 space-y-6">
          <div class="flex flex-col md:flex-row gap-6 items-start">
            <!-- Left side: Logo Preview & Upload -->
            <div class="w-full md:w-1/3 flex flex-col items-center text-center p-4 bg-slate-50/50 border border-slate-150 rounded-2xl">
              <span class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Logotipo Comercial</span>
              <div class="w-32 h-32 rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-sm flex items-center justify-center relative mb-4">
                <img src="<%= partner.logo || '/images/default-logo.png' %>" alt="Logo de <%= partner.name %>" class="w-full h-full object-contain p-2" id="profile-logo-preview">
              </div>
              <label for="profile-logo" class="w-full py-2 px-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs shadow-sm hover:shadow transition-all cursor-pointer text-center">
                <i class="fa-solid fa-camera mr-1"></i> Cambiar Logo
              </label>
              <input type="file" id="profile-logo" name="logo" accept="image/*" class="hidden" onchange="previewProfileLogo(event)">
              <p class="text-[10px] text-slate-400 mt-2">Relación de aspecto 1:1 recomendada. Formatos JPG, PNG o WEBP.</p>
            </div>

            <!-- Right side: Text Fields -->
            <div class="flex-1 w-full space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Name -->
                <div>
                  <label for="profile-name" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nombre Comercial *</label>
                  <input type="text" id="profile-name" name="name" required value="<%= partner.name %>"
                    class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
                </div>

                <!-- Email (Read-Only) -->
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5 flex items-center gap-1">
                    <span>Correo de Acceso</span>
                    <i class="fa-solid fa-lock text-[9px] text-slate-400"></i>
                  </label>
                  <input type="email" disabled value="<%= partner.email %>"
                    class="w-full bg-slate-100 border border-slate-200 text-slate-450 px-4 py-2.5 rounded-xl outline-none text-xs font-bold select-all">
                </div>
              </div>

              <!-- Description -->
              <div>
                <label for="profile-description" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Descripción de la Empresa / Socio</label>
                <textarea id="profile-description" name="description" rows="3" placeholder="Describe brevemente tu negocio o productos principales..."
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium resize-none"><%= partner.description || '' %></textarea>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Phone -->
                <div>
                  <label for="profile-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Teléfono de Contacto</label>
                  <input type="text" id="profile-phone" name="phone" value="<%= partner.phone || '' %>" placeholder="Ej: +54 11 1234-5678"
                    class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
                </div>

                <!-- Website -->
                <div>
                  <label for="profile-website" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Sitio Web</label>
                  <input type="url" id="profile-website" name="website" value="<%= partner.website || '' %>" placeholder="Ej: https://misitioweb.com"
                    class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
                </div>
              </div>

              <!-- Address (Ubicación Principal) -->
              <div>
                <label for="profile-address" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Dirección / Ubicación Principal</label>
                <input type="text" id="profile-address" name="address" value="<%= partner.address || '' %>" placeholder="Ej: Av. Rivadavia 1234, CABA"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
              </div>
            </div>
          </div>

          <hr class="border-slate-100">

          <!-- Password change section -->
          <div class="bg-amber-50/20 border border-amber-100 rounded-2xl p-5 space-y-4">
            <h3 class="text-xs font-bold text-amber-850 uppercase tracking-wider flex items-center gap-1.5">
              <i class="fa-solid fa-key"></i> Cambiar Contraseña (Opcional)
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="profile-password" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Nueva Contraseña</label>
                <input type="password" id="profile-password" name="password" placeholder="Ingresar nueva contraseña" minlength="6"
                  class="w-full bg-white border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
              </div>
              <div>
                <label for="profile-password-confirm" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Confirmar Nueva Contraseña</label>
                <input type="password" id="profile-password-confirm" placeholder="Repetir nueva contraseña" minlength="6"
                  class="w-full bg-white border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-xs font-medium">
              </div>
            </div>
            <p class="text-[10px] text-slate-400">Deja ambos campos en blanco si no deseas cambiar tu contraseña actual.</p>
          </div>

          <div class="flex justify-end gap-3">
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-md transition-all flex items-center gap-2">
              Guardar Cambios de Perfil
              <i class="fa-solid fa-floppy-disk"></i>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

</div>

<!-- Modal for Editing Product Details (Title, Description, Category) -->
<div id="edit-partner-product-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white rounded-3xl border border-slate-200 shadow-xl max-w-lg w-full overflow-hidden transition-all transform scale-95 duration-150" id="edit-modal-card">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
      <h3 class="display-font text-base font-extrabold text-slate-900 flex items-center gap-2">
        <i class="fa-solid fa-pen-to-square text-brand-650"></i>
        <span>Editar Detalles del Producto</span>
      </h3>
      <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-650 p-1.5 rounded-lg hover:bg-slate-100 transition-all">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>
    
    <form id="edit-partner-product-form" action="" method="POST" class="p-6 space-y-4">
      <div>
        <label for="edit-title" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nombre del Producto</label>
