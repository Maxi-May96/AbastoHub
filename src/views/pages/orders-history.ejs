<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10 pb-6 border-b border-slate-200">
    <div>
      <h1 class="display-font text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
        <span class="text-brand-600"><i class="fa-solid fa-clock-rotate-left"></i></span>
        Historial de Compras
      </h1>
      <p class="text-sm text-slate-500 mt-1">Revisa el estado de tus compras, descarga tus comprobantes y sube comprobantes de pago.</p>
    </div>
    <a href="/products" class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl shadow-sm transition-all">
      <i class="fa-solid fa-bag-shopping"></i> Ir a la Tienda
    </a>
  </div>
  <!-- Messages Feedback -->
  <% if (locals.success) { %>
    <div class="mb-6 bg-emerald-50 border border-emerald-100 text-emerald-700 p-4 rounded-2xl text-sm flex gap-2 items-center">
      <i class="fa-solid fa-circle-check text-base"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (locals.error) { %>
    <div class="mb-6 bg-rose-50 border border-rose-100 text-rose-700 p-4 rounded-2xl text-sm flex gap-2 items-center">
      <i class="fa-solid fa-circle-exclamation text-base"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (orders && orders.length > 0) { %>
    <!-- Orders List Container -->
    <div class="space-y-6">
      <% orders.forEach(order => { %>
        <div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col gap-4">
          
          <!-- Card Header: Metadata and Total -->
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-slate-100">
            <!-- Order Meta details -->
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-bold text-slate-900">Pedido #<%= order._id.toString().substring(12).toUpperCase() %></span>
                
                <!-- Payment Status Badge -->
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold border 
                  <% if (order.paymentStatus === 'paid') { %> bg-emerald-50 text-emerald-700 border-emerald-100 
                  <% } else if (order.paymentStatus === 'pending') { %> bg-amber-50 text-amber-700 border-amber-100 
                  <% } else if (order.paymentStatus === 'cancelled') { %> bg-rose-50 text-rose-700 border-rose-100
                  <% } else { %> bg-rose-50 text-rose-700 border-rose-100 <% } %>">
                  Pago: <%= order.paymentStatus === 'paid' ? 'ACREDITADO' : order.paymentStatus === 'pending' ? 'PENDIENTE' : (order.paymentStatus === 'cancelled' ? 'CANCELADO' : 'FALLIDO') %>
                </span>

                <!-- Order Status Badge -->
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold border 
                  <% if (order.status === 'delivered') { %> bg-emerald-50 text-emerald-700 border-emerald-100 
                  <% } else if (order.status === 'shipped' || order.status === 'ready_for_pickup') { %> bg-blue-50 text-blue-700 border-blue-100
                  <% } else if (order.status === 'preparing') { %> bg-indigo-50 text-indigo-700 border-indigo-100
                  <% } else if (order.status === 'cancelled') { %> bg-rose-50 text-rose-700 border-rose-100
                  <% } else { %> bg-amber-50 text-amber-700 border-amber-100 <% } %>">
                  Pedido: 
                  <% if (order.status === 'pending') { %> Pendiente
                  <% } else if (order.status === 'preparing') { %> En Preparación
                  <% } else if (order.status === 'shipped') { %> En Camino
                  <% } else if (order.status === 'ready_for_pickup') { %> Listo para Retirar
                  <% } else if (order.status === 'delivered') { %> Entregado
                  <% } else if (order.status === 'cancelled') { %> Cancelado <% } %>
                </span>
              </div>
              <p class="text-xs text-slate-400">Realizado el: <%= order.createdAt.toLocaleString('es-AR') %></p>
            </div>

            <!-- Total price info -->
            <div class="sm:text-right flex sm:flex-col items-baseline sm:items-end gap-2 sm:gap-0">
              <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">Total</span>
              <p class="text-xl font-extrabold text-slate-900"><%= formatPrice(order.total) %></p>
            </div>
          </div>

          <!-- Card Content Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Products List (2/3 width on desktop) -->
            <div class="md:col-span-2 space-y-2.5">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Productos</span>
              <div class="space-y-1.5 max-h-36 overflow-y-auto pr-2 custom-scrollbar">
                <% order.products.forEach(item => { %>
                  <div class="text-xs text-slate-650 flex justify-between items-center gap-4 py-1 border-b border-slate-50 last:border-0">
                    <span class="truncate font-medium text-slate-700"><%= item.quantity %> × <%= item.title %> (<%= item.unit %>)</span>
                    <span class="font-semibold text-slate-900 flex-shrink-0"><%= formatPrice(item.price * item.quantity) %></span>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Delivery / Logistics Details (1/3 width on desktop) -->
            <div class="space-y-3 bg-slate-50/50 rounded-2xl p-4 border border-slate-100 text-xs text-slate-600">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Despacho</span>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-truck text-slate-400 text-xs w-4"></i>
                  <p><strong>Tipo:</strong> <%= order.deliveryType === 'delivery' ? 'Envío a Domicilio' : 'Retiro en Local' %></p>
                </div>
                <% if (order.scheduledDate) { %>
                  <div class="flex items-center gap-2 text-brand-700 font-semibold">
                    <i class="fa-solid fa-calendar-day text-brand-500 text-xs w-4"></i>
                    <p>Reserva: <%= order.scheduledDate.toLocaleDateString('es-AR') %></p>
                  </div>
                <% } %>
                <% if (order.status === 'shipped' && order.driverName) { %>
                  <div class="flex items-center gap-2 text-emerald-700 font-semibold">
                    <i class="fa-solid fa-truck-fast text-emerald-500 text-xs w-4"></i>
                    <p>En camino por: <%= order.driverName %> <%= order.driverVehicle ? `(${order.driverVehicle})` : '' %></p>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Full Width Alerts (Raffle / Cancel status) -->
          <% if (order.raffleCode) { %>
            <div class="w-full">
              <% if (order.status === 'delivered') { %>
                <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-250/80 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-600 text-lg flex-shrink-0">
                      <i class="fa-solid fa-ticket"></i>
                    </div>
                    <div>
                      <h4 class="font-bold text-slate-800 text-xs">Código de Sorteo Activado</h4>
                      <p class="text-[10px] text-slate-500 mt-0.5">Usa este código para registrarte y participar en el sorteo de AbastoHub.</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 flex-shrink-0 w-full sm:w-auto justify-between sm:justify-end">
                    <span class="bg-white border border-amber-200 text-amber-800 font-extrabold text-xs tracking-wider px-3.5 py-2 rounded-xl select-all font-mono">
                      <%= order.raffleCode %>
                    </span>
                    <a href="/sorteo?code=<%= order.raffleCode %>" class="bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs px-4 py-2 rounded-xl transition-all shadow-xs flex items-center gap-1">
                      <i class="fa-solid fa-trophy text-[10px]"></i> Participar
                    </a>
                  </div>
                </div>
              <% } else if (order.status !== 'cancelled') { %>
                <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-3.5 flex items-center gap-2.5 text-slate-550 text-[11px] font-medium animate-pulse">
                  <i class="fa-solid fa-circle-info text-slate-400 text-sm flex-shrink-0"></i>
                  <p>El código de sorteo se activará cuando confirmes la recepción del pedido.</p>
                </div>
              <% } %>
            </div>
          <% } %>

          <% if (order.status === 'cancelled') { %>
            <div class="bg-rose-50 border border-rose-150 rounded-2xl p-4 flex gap-3 items-start text-xs text-rose-800">
              <i class="fa-solid fa-circle-exclamation text-rose-600 text-sm mt-0.5"></i>
              <div>
                <p class="font-bold text-rose-900">Pedido Cancelado</p>
                <p class="text-rose-700 mt-0.5">La devolución de tu dinero impactará en tu cuenta dentro de las 24 a 72 horas hábiles.</p>
              </div>
            </div>
          <% } %>

          <!-- Card Footer: Action Buttons (Responsive Layout) -->
          <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-end items-stretch sm:items-center gap-2">
            <% if (order.status === 'shipped') { %>
              <form action="/orders/<%= order._id %>/receive" method="POST" class="w-full sm:w-auto"
                onsubmit="return confirm('¿Seguro que has recibido el pedido correctamente? Esto habilitará tu código para el sorteo.');">
                <button type="submit" 
                  class="w-full text-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center gap-1.5">
                  <i class="fa-solid fa-circle-check text-[11px]"></i> Confirmar Recepción
                </button>
              </form>
            <% } %>
            
            <% if (!['shipped', 'delivered', 'cancelled'].includes(order.status)) { %>
              <form action="/orders/<%= order._id %>/cancel" method="POST" class="w-full sm:w-auto"
                onsubmit="return confirm('¿Seguro deseas cancelar este pedido y solicitar un reembolso?');">
                <button type="submit" 
                  class="w-full text-center px-4 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs rounded-xl border border-rose-250 transition-all flex items-center justify-center gap-1.5">
                  <i class="fa-solid fa-ban text-[11px]"></i> Cancelar y Reembolso
                </button>
              </form>
            <% } %>

            <div class="flex items-center gap-2 w-full sm:w-auto">
              <a href="/orders/<%= order._id %>/ticket" target="_blank" 
                class="flex-1 sm:flex-none text-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-file-pdf text-[11px] text-rose-500"></i> Ticket PDF
              </a>
              <a href="/payment/feedback?orderId=<%= order._id %>" 
                class="flex-1 sm:flex-none text-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-receipt text-[11px]"></i> Ver Detalles
              </a>
            </div>
          </div>

        </div>
      <% }) %>
    </div>

  <% } else { %>
    <!-- Empty State -->
    <div class="bg-white border border-slate-200 rounded-3xl p-12 text-center max-w-md mx-auto shadow-sm">
      <div class="w-16 h-16 rounded-full bg-slate-50 flex items-center justify-center mx-auto text-slate-400 mb-6">
        <i class="fa-solid fa-receipt text-3xl"></i>
      </div>
      <h3 class="display-font text-lg font-bold text-slate-800">Aún no tienes compras</h3>
      <p class="text-xs text-slate-500 mt-2 leading-relaxed">Cuando realices compras en AbastoHub, podrás ver el historial y detalles de cada una de ellas desde este panel.</p>
      <div class="mt-8">
        <a href="/products" class="inline-flex items-center gap-1.5 px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl shadow-md shadow-brand-500/10 transition-all">
          Comenzar a Comprar <i class="fa-solid fa-chevron-right text-[9px]"></i>
        </a>
      </div>
    </div>
  <% } %>

</div>

<%- include('../partials/footer') %>
