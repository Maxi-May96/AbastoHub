<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <div class="mb-8">
    <h1 class="display-font text-3xl font-extrabold tracking-tight text-slate-900">Checkout</h1>
    <p class="text-sm text-slate-500 mt-1">Completa los datos de envío y selecciona tu método de pago preferido.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 bg-rose-50 border border-rose-250 text-rose-800 p-4 rounded-2xl text-xs sm:text-sm font-semibold flex gap-2.5 items-center shadow-2xs">
      <i class="fa-solid fa-circle-exclamation text-base text-rose-600"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    
    <!-- Delivery Details Form (Col Span 2) -->
    <div class="lg:col-span-2">
      <form action="/checkout" method="POST" id="checkout-form" enctype="multipart/form-data" class="space-y-6">
        <input type="hidden" name="couponCode" id="hidden-coupon-code" value="">
        
        <!-- Section 1: Customer Contact Details -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-4">
          <h2 class="display-font text-lg font-bold text-slate-950 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="text-brand-600"><i class="fa-solid fa-address-card"></i></span>
            Datos del Destinatario
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nombre Completo</label>
              <input type="text" id="name" name="name" required placeholder="Juan Pérez"
                value="<%= user ? `${user.name} ${user.lastname}` : '' %>"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            </div>
            <div>
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Teléfono de Contacto</label>
              <input type="text" id="phone" name="phone" required placeholder="+541155550199"
                value="<%= user ? user.phone : '' %>"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            </div>
          </div>
        </div>

        <!-- Section 2: Delivery Type Selector -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-4">
          <h2 class="display-font text-lg font-bold text-slate-950 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="text-brand-600"><i class="fa-solid fa-truck"></i></span>
            Método de Entrega
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Delivery Option Card -->
            <label class="relative flex items-center justify-between p-4 border border-brand-500 bg-brand-50/20 rounded-2xl cursor-pointer hover:bg-slate-50/10 transition-all delivery-type-card" id="card-delivery-type-delivery">
              <div class="flex items-center gap-3">
                <input type="radio" name="deliveryType" value="delivery" checked onchange="toggleDeliveryType('delivery')" class="h-4.5 w-4.5 text-brand-600 border-slate-300 focus:ring-brand-500/20">
                <div>
                  <span class="block text-sm font-bold text-slate-850">Envío a Domicilio</span>
                  <span class="block text-xs text-slate-500">Recibe en tu casa o comercio</span>
                </div>
              </div>
              <i class="fa-solid fa-house-chimney text-brand-600 text-lg"></i>
            </label>

            <!-- Pickup Option Card -->
            <label class="relative flex items-center justify-between p-4 border border-slate-200 rounded-2xl cursor-pointer hover:bg-slate-50/10 transition-all delivery-type-card" id="card-delivery-type-pickup">
              <div class="flex items-center gap-3">
                <input type="radio" name="deliveryType" value="pickup" onchange="toggleDeliveryType('pickup')" class="h-4.5 w-4.5 text-brand-600 border-slate-300 focus:ring-brand-500/20">
                <div>
                  <span class="block text-sm font-bold text-slate-850">Retiro por Local</span>
                  <span class="block text-xs text-slate-500">Retira en los puntos de venta</span>
                </div>
              </div>
              <i class="fa-solid fa-store text-slate-400 text-lg"></i>
            </label>
          </div>

          <!-- Cost Explanation info -->
          <div id="delivery-info-box" class="flex items-start gap-2.5 p-3.5 bg-brand-50/25 border border-brand-200/40 rounded-2xl text-[11px] text-brand-900 shadow-3xs leading-relaxed">
            <i class="fa-solid fa-circle-info text-brand-650 mt-0.5 text-xs"></i>
            <span><strong>Envío a Domicilio:</strong> El costo del envío se cobra <strong>por separado</strong> del total de los productos comprados en la plataforma, a coordinar directamente con el transportista/conductor asignado.</span>
          </div>

          <!-- Pickup locations list (Hidden by default, shown when pickup is chosen) -->
          <div id="pickup-locations-box" class="hidden space-y-3 p-4 bg-slate-50 border border-slate-150 rounded-2xl">
            <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-200/60 pb-1.5">
              <i class="fa-solid fa-map-location-dot text-brand-600"></i>
              Locales / Sucursales para Retiro
            </h4>
            <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
              <% 
                const pickupLocations = [];
                cart.products.forEach(item => {
                  if (item.product && item.product.partner) {
                    const partner = item.product.partner;
                    if (item.product.location && partner.locations && partner.locations.length > 0) {
                      const loc = partner.locations.find(l => l._id.toString() === item.product.location.toString());
                      if (loc) {
                        const locKey = loc._id.toString();
                        if (!pickupLocations.some(p => p.id === locKey)) {
                          pickupLocations.push({
                            id: locKey,
                            name: `${partner.name} - Sucursal: ${loc.name}`,
                            address: `${loc.address}, ${loc.province}`,
                            lat: loc.latitude,
                            lng: loc.longitude
                          });
                        }
                      }
                    } else {
                      const locKey = partner._id.toString() + '_main';
                      if (!pickupLocations.some(p => p.id === locKey)) {
                        pickupLocations.push({
                          id: locKey,
                          name: `${partner.name} (Ubicación Principal)`,
                          address: `${partner.address}, ${partner.province}`,
                          lat: partner.latitude,
                          lng: partner.longitude
                        });
                      }
                    }
                  }
                });
                if (pickupLocations.length === 0) {
              %>
                <p class="text-xs text-slate-500 italic">No hay locales registrados para los productos de tu carrito. Retiro en administración central.</p>
              <% } else { 
                pickupLocations.forEach(loc => { %>
                  <div class="text-xs bg-white p-2.5 rounded-xl border border-slate-200 flex items-center justify-between gap-3 shadow-3xs">
                    <div>
                      <p class="font-bold text-slate-850"><%= loc.name %></p>
                      <p class="text-slate-500 text-[10px] mt-0.5"><%= loc.address %></p>
                    </div>
                    <% if (loc.lat && loc.lng) { %>
                      <a href="https://www.google.com/maps/search/?api=1&query=<%= loc.lat %>,<%= loc.lng %>" target="_blank"
                        class="p-2 bg-brand-50 hover:bg-brand-100 text-brand-700 rounded-lg transition-all" title="Ver en Google Maps">
                        <i class="fa-solid fa-map-location text-sm"></i>
                      </a>
                    <% } %>
                  </div>
                <% }); 
              } %>
            </div>
            <p class="text-[9px] text-slate-450 mt-1.5">Debes retirar tus productos en las direcciones arriba indicadas correspondientes a cada productor de tu pedido.</p>
          </div>
        </div>

        <!-- Section 3: Shipping Address -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-4 transition-all duration-300" id="address-section">
          <h2 class="display-font text-lg font-bold text-slate-950 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="text-brand-600"><i class="fa-solid fa-map-location-dot"></i></span>
            Dirección de Envío
          </h2>
          
          <div class="space-y-4">
            <!-- Hidden coordinates inputs -->
            <input type="hidden" name="latitude" id="latitude" value="<%= (defaultAddress && defaultAddress.latitude) ? defaultAddress.latitude : '' %>">
            <input type="hidden" name="longitude" id="longitude" value="<%= (defaultAddress && defaultAddress.longitude) ? defaultAddress.longitude : '' %>">

            <div>
              <label for="street" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Calle y Número</label>
              <input type="text" id="street" name="street" placeholder="Ej: Av. Cabildo 2340, Piso 3A" required
                value="<%= defaultAddress ? defaultAddress.street : '' %>"
                class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="province" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Provincia</label>
                <select id="province" name="province" required
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
                  <option value="">Seleccione...</option>
                  <option value="CABA" <%= (defaultAddress && defaultAddress.province === 'CABA') ? 'selected' : '' %>>CABA (Capital Federal)</option>
                  <option value="Buenos Aires" <%= (defaultAddress && defaultAddress.province === 'Buenos Aires') ? 'selected' : '' %>>Buenos Aires</option>
                  <option value="Catamarca" <%= (defaultAddress && defaultAddress.province === 'Catamarca') ? 'selected' : '' %>>Catamarca</option>
                  <option value="Chaco" <%= (defaultAddress && defaultAddress.province === 'Chaco') ? 'selected' : '' %>>Chaco</option>
                  <option value="Chubut" <%= (defaultAddress && defaultAddress.province === 'Chubut') ? 'selected' : '' %>>Chubut</option>
                  <option value="Córdoba" <%= (defaultAddress && defaultAddress.province === 'Córdoba') ? 'selected' : '' %>>Córdoba</option>
                  <option value="Corrientes" <%= (defaultAddress && defaultAddress.province === 'Corrientes') ? 'selected' : '' %>>Corrientes</option>
                  <option value="Entre Ríos" <%= (defaultAddress && defaultAddress.province === 'Entre Ríos') ? 'selected' : '' %>>Entre Ríos</option>
                  <option value="Formosa" <%= (defaultAddress && defaultAddress.province === 'Formosa') ? 'selected' : '' %>>Formosa</option>
                  <option value="Jujuy" <%= (defaultAddress && defaultAddress.province === 'Jujuy') ? 'selected' : '' %>>Jujuy</option>
                  <option value="La Pampa" <%= (defaultAddress && defaultAddress.province === 'La Pampa') ? 'selected' : '' %>>La Pampa</option>
                  <option value="La Rioja" <%= (defaultAddress && defaultAddress.province === 'La Rioja') ? 'selected' : '' %>>La Rioja</option>
                  <option value="Mendoza" <%= (defaultAddress && defaultAddress.province === 'Mendoza') ? 'selected' : '' %>>Mendoza</option>
                  <option value="Misiones" <%= (defaultAddress && defaultAddress.province === 'Misiones') ? 'selected' : '' %>>Misiones</option>
                  <option value="Neuquén" <%= (defaultAddress && defaultAddress.province === 'Neuquén') ? 'selected' : '' %>>Neuquén</option>
                  <option value="Río Negro" <%= (defaultAddress && defaultAddress.province === 'Río Negro') ? 'selected' : '' %>>Río Negro</option>
                  <option value="Salta" <%= (defaultAddress && defaultAddress.province === 'Salta') ? 'selected' : '' %>>Salta</option>
                  <option value="San Juan" <%= (defaultAddress && defaultAddress.province === 'San Juan') ? 'selected' : '' %>>San Juan</option>
                  <option value="San Luis" <%= (defaultAddress && defaultAddress.province === 'San Luis') ? 'selected' : '' %>>San Luis</option>
                  <option value="Santa Cruz" <%= (defaultAddress && defaultAddress.province === 'Santa Cruz') ? 'selected' : '' %>>Santa Cruz</option>
                  <option value="Santa Fe" <%= (defaultAddress && defaultAddress.province === 'Santa Fe') ? 'selected' : '' %>>Santa Fe</option>
                  <option value="Santiago del Estero" <%= (defaultAddress && defaultAddress.province === 'Santiago del Estero') ? 'selected' : '' %>>Santiago del Estero</option>
                  <option value="Tierra del Fuego" <%= (defaultAddress && defaultAddress.province === 'Tierra del Fuego') ? 'selected' : '' %>>Tierra del Fuego</option>
                  <option value="Tucumán" <%= (defaultAddress && defaultAddress.province === 'Tucumán') ? 'selected' : '' %>>Tucumán</option>
                </select>
              </div>
              <div>
                <label for="city" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Localidad / Ciudad</label>
                <input type="text" id="city" name="city" placeholder="Belgrano" required
                  value="<%= defaultAddress ? defaultAddress.city : '' %>"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
              </div>
              <div>
                <label for="zipCode" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Código Postal</label>
                <input type="text" id="zipCode" name="zipCode" placeholder="C1428" required
                  value="<%= defaultAddress ? defaultAddress.zipCode : '' %>"
                  class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
              </div>
            </div>

            <!-- GPS Map Integration -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Ubicación GPS Exacta</label>
              <div id="map" style="height: 300px; width: 100%; border-radius: 1rem; margin-top: 1rem; border: 1px solid #cbd5e1;"></div>
              <p class="text-[10px] text-slate-400 flex items-center gap-1.5 mt-1.5">
                <i class="fa-solid fa-location-dot text-indigo-500 text-xs"></i>
                Haz click en el mapa o arrastra el marcador rojo para indicar la posición exacta de entrega.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 4: Reservation Date -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-4">
          <h2 class="display-font text-lg font-bold text-slate-950 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="text-brand-600"><i class="fa-solid fa-calendar-day"></i></span>
            Fecha de Reserva
          </h2>
          
          <div class="space-y-2">
            <label for="scheduledDate" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Seleccionar Fecha (Opcional)</label>
            <input type="date" id="scheduledDate" name="scheduledDate"
              class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm">
            <p class="text-[10px] text-slate-450 mt-1">Elige un día a partir de hoy si deseas coordinar tu entrega o retiro para una fecha específica.</p>
          </div>
        </div>

        <!-- Section 5: Notes -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-4">
          <h2 class="display-font text-lg font-bold text-slate-950 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="text-brand-600"><i class="fa-solid fa-message"></i></span>
            Notas Adicionales
          </h2>
          <div>
            <label for="notes" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Instrucciones para la entrega (Opcional)</label>
            <textarea id="notes" name="notes" rows="3" placeholder="Tocar timbre en el portón verde. Dejar en recepción..."
              class="w-full bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-4 py-2.5 rounded-xl outline-none focus:ring-4 focus:ring-brand-500/10 transition-all text-sm resize-none"></textarea>
          </div>
        </div>

        <!-- Section 6: Payment Method -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-4">
          <h2 class="display-font text-lg font-bold text-slate-950 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span class="text-brand-600"><i class="fa-solid fa-credit-card"></i></span>
            Método de Pago
          </h2>

          <div class="space-y-4">
            <!-- Payment Selector Options -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- MercadoPago Option -->
              <label class="relative flex items-center justify-between p-4 border border-brand-500 bg-brand-50/20 rounded-2xl cursor-pointer hover:bg-slate-50/10 transition-all payment-method-card" id="card-mp">
                <div class="flex items-center gap-3">
                  <input type="radio" name="paymentMethod" value="mercadopago" checked onchange="togglePaymentMethod('mercadopago')" class="h-4.5 w-4.5 text-brand-600 border-slate-300 focus:ring-brand-500/20">
                  <div>
                    <span class="block text-sm font-bold text-slate-850">MercadoPago</span>
                    <span class="block text-xs text-slate-500">Tarjetas, dinero en cuenta o PSE</span>
                  </div>
                </div>
                <i class="fa-solid fa-wallet text-brand-600 text-lg"></i>
              </label>

              <!-- Bank Transfer Option -->
              <label class="relative flex items-center justify-between p-4 border border-slate-200 rounded-2xl cursor-pointer hover:bg-slate-50/10 transition-all payment-method-card" id="card-transfer">
                <div class="flex items-center gap-3">
                  <input type="radio" name="paymentMethod" value="transfer" onchange="togglePaymentMethod('transfer')" class="h-4.5 w-4.5 text-brand-600 border-slate-300 focus:ring-brand-500/20">
                  <div>
                    <span class="block text-sm font-bold text-slate-850">Transferencia Bancaria</span>
                    <span class="block text-xs text-slate-500">Pago directo vía alias CBU</span>
                  </div>
                </div>
                <i class="fa-solid fa-bank text-slate-400 text-lg"></i>
              </label>
            </div>

            <!-- Transfer Instructions & Upload Receipt Details (Hidden by default) -->
            <div id="transfer-instructions" class="hidden bg-slate-50 border border-slate-200 rounded-2xl p-4.5 space-y-3.5 transition-all">
              <div class="bg-indigo-50 border border-indigo-150 p-4 rounded-xl space-y-2 text-indigo-950">
                <h4 class="font-extrabold text-xs uppercase tracking-wider text-indigo-900 flex items-center gap-1.5">
                  <i class="fa-solid fa-circle-info text-sm text-indigo-650"></i>
                  Instrucciones de Transferencia
                </h4>
                <p class="text-xs leading-relaxed font-medium">
                  Realiza la transferencia desde tu homebanking o billetera virtual por el <strong>monto total de tu pedido</strong> utilizando el siguiente alias:
                </p>
                <div class="bg-white border border-indigo-200/60 rounded-xl px-4 py-2.5 flex items-center justify-between shadow-2xs">
                  <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Alias MercadoPago / Banco</span>
                    <span class="text-sm font-mono font-black text-indigo-800 select-all tracking-wide">mayolstudio96</span>
                  </div>
                  <button type="button" onclick="navigator.clipboard.writeText('mayolstudio96'); alert('¡Alias copiado al portapapeles!');" class="p-2 bg-indigo-50 hover:bg-indigo-100 rounded-lg text-indigo-700 transition-all" title="Copiar Alias">
                    <i class="fa-solid fa-copy text-sm"></i>
                  </button>
                </div>
                <ul class="list-disc pl-4 text-[11px] space-y-1.5 mt-2 text-indigo-800 font-medium">
                  <li>Transfiere el importe total correspondiente.</li>
                  <li>Descarga o toma una captura de pantalla del <strong>comprobante de la transferencia</strong>.</li>
                  <li>Sube el archivo (imagen o PDF) en el campo a continuación para que validemos tu pago.</li>
                </ul>
              </div>

              <!-- Upload field -->
              <div>
                <label for="receipt" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Subir Comprobante de Transferencia (Obligatorio)</label>
                <input type="file" id="receipt" name="receipt" accept="image/*,application/pdf"
                  class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 text-xs text-slate-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 transition-all">
                <p class="text-[10px] text-slate-400 mt-1.5">Formatos admitidos: JPG, JPEG, PNG, PDF. Tamaño máximo: 5MB.</p>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Order Review Card (Col Span 1) -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-6 lg:sticky lg:top-24">
      <h3 class="display-font text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Resumen del Pedido</h3>
      
      <!-- Mini Cart Items List -->
      <div class="space-y-3.5 max-h-60 overflow-y-auto pr-1 custom-scrollbar">
        <% cart.products.forEach(item => { %>
          <% if (item.product) { %>
            <div class="flex items-center gap-3 justify-between text-xs">
              <div class="truncate flex-grow">
                <p class="font-bold text-slate-800 truncate"><%= item.product.title %></p>
                <p class="text-slate-400">Cantidad: <%= item.quantity %> <%= item.product.unit %></p>
              </div>
              <span class="font-semibold text-slate-700 text-right"><%= formatPrice(item.activePrice * item.quantity) %></span>
            </div>
          <% } %>
        <% }); %>
      </div>

      <hr class="border-slate-100">

      <div class="space-y-2 text-xs">
        <div class="flex justify-between text-slate-500">
          <span>Subtotal</span>
          <span id="summary-subtotal"><%= formatPrice(total) %></span>
        </div>
        <div class="flex justify-between text-slate-500 hidden" id="discount-row">
          <span>Descuento</span>
          <span id="discount-amount" class="font-bold text-emerald-600">-$0.00</span>
        </div>
        <div class="flex justify-between text-slate-500">
          <span>Envío</span>
          <span id="summary-shipping-cost" class="font-medium text-emerald-600">A coordinar</span>
        </div>
        <div class="flex justify-between text-slate-500 hidden" id="platform-fee-row">
          <span>Uso de plataforma (5%)</span>
          <span id="platform-fee-amount" class="font-semibold text-rose-600">+$0.00</span>
        </div>
        <div class="flex justify-between text-slate-500 hidden" id="gateway-fee-row">
          <span>Impuestos + IVA (15%)</span>
          <span id="gateway-fee-amount" class="font-semibold text-rose-600">+$0.00</span>
        </div>
      </div>

      <hr class="border-slate-100">

      <!-- Coupon section -->
      <div class="space-y-2.5">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">¿Tienes un cupón de descuento?</label>
        <div class="flex gap-2">
          <input type="text" id="coupon-input" placeholder="Ingresa el código" 
            class="flex-grow bg-slate-50 border border-slate-200 focus:border-brand-500/40 focus:bg-white text-slate-800 placeholder-slate-400 px-3 py-2.5 rounded-xl outline-none text-xs font-mono font-bold uppercase">
          <button type="button" onclick="applyCoupon()" 
            class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-950 text-white font-bold text-xs shadow-sm transition-all whitespace-nowrap">
            Aplicar
          </button>
        </div>
        <div id="coupon-message" class="text-[10.5px] font-semibold hidden"></div>
      </div>

      <hr class="border-slate-100">

      <div class="flex justify-between items-baseline">
        <span class="display-font text-base font-extrabold text-slate-900">Total</span>
        <span class="display-font text-2xl font-black text-brand-700" id="summary-total"><%= formatPrice(total) %></span>
      </div>

      <!-- Secure check outline info -->
      <div id="secure-info-box" class="bg-slate-50 border border-slate-150 p-3.5 rounded-2xl flex gap-3 items-start text-[11px] text-slate-500 leading-normal">
        <i class="fa-solid fa-shield-halved text-brand-600 text-base mt-0.5"></i>
        <span>
          Serás redirigido a <strong>MercadoPago</strong> de forma 100% segura para abonar tu orden. Aceptamos tarjetas de débito/crédito y dinero en cuenta.
        </span>
      </div>

      <!-- Action Button -->
      <button type="submit" form="checkout-form" class="w-full py-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-md hover:shadow-lg shadow-brand-500/10 hover:shadow-brand-500/20 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
        <span>Proceder al Pago</span>
        <i class="fa-solid fa-chevron-right text-[11px]"></i>
      </button>
    </div>

  </div>
</div>

<!-- Scripts for address and Google Maps integration -->
<script>
  let map;
  let marker;
  const baseTotal = <%= total %>;
  
  // Set default starting lat/lng from user's defaultAddress if present
  const defaultLat = <%= (defaultAddress && defaultAddress.latitude) ? defaultAddress.latitude : -34.6037 %>;
  const defaultLng = <%= (defaultAddress && defaultAddress.longitude) ? defaultAddress.longitude : -58.3816 %>;
  const hasSavedCoords = <%= (defaultAddress && defaultAddress.latitude && defaultAddress.longitude) ? 'true' : 'false' %>;

  function initMap() {
    const latInput = document.getElementById('latitude');
    const lngInput = document.getElementById('longitude');

    // Default coordinates in inputs if empty
    if (!latInput.value) latInput.value = defaultLat;
    if (!lngInput.value) lngInput.value = defaultLng;

    const mapOptions = {
      center: { lat: parseFloat(latInput.value), lng: parseFloat(lngInput.value) },
      zoom: hasSavedCoords ? 16 : 13,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: false
    };

    map = new google.maps.Map(document.getElementById("map"), mapOptions);

    marker = new google.maps.Marker({
      position: { lat: parseFloat(latInput.value), lng: parseFloat(lngInput.value) },
      map: map,
      draggable: true,
      animation: google.maps.Animation.DROP
    });

    // Autocomplete setup for street input
    const streetInput = document.getElementById('street');
    const autocomplete = new google.maps.places.Autocomplete(streetInput, {
      componentRestrictions: { country: "ar" },
      fields: ["address_components", "geometry"],
      types: ["address"]
    });

    autocomplete.addListener('place_changed', function() {
      const place = autocomplete.getPlace();
      if (!place.geometry || !place.geometry.location) {
        return;
      }

      const location = place.geometry.location;
      map.setCenter(location);
      map.setZoom(17);
      marker.setPosition(location);

      latInput.value = location.lat();
      lngInput.value = location.lng();

      // Autofill components
      const components = place.address_components;
      for (let component of components) {
        const types = component.types;
        if (types.includes("locality") || types.includes("sublocality") || types.includes("administrative_area_level_2")) {
          document.getElementById('city').value = component.long_name;
        }
        if (types.includes("postal_code")) {
          document.getElementById('zipCode').value = component.long_name;
        }
        if (types.includes("administrative_area_level_1")) {
          const provinceSelect = document.getElementById('province');
          const valueLower = component.long_name.toLowerCase();
          
          // Match selected options
          for (let option of provinceSelect.options) {
            if (valueLower.includes(option.value.toLowerCase()) || option.value.toLowerCase().includes(valueLower)) {
              provinceSelect.value = option.value;
              break;
            }
          }
          if (valueLower.includes("caba") || valueLower.includes("ciudad autónoma de buenos aires") || valueLower.includes("capital federal")) {
            provinceSelect.value = "CABA";
          }
        }
      }
    });

    // Update coordinates when marker is dragged
    google.maps.event.addListener(marker, 'dragend', function() {
      const pos = marker.getPosition();
      latInput.value = pos.lat();
      lngInput.value = pos.lng();
    });

    // Update marker and coordinates when map is clicked
    map.addListener('click', function(e) {
      const clickedPos = e.latLng;
      marker.setPosition(clickedPos);
      latInput.value = clickedPos.lat();
      lngInput.value = clickedPos.lng();
    });

    // Attempt geolocation only if no saved coordinates exist
    if (!hasSavedCoords && navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(position) {
        const userLat = position.coords.latitude;
        const userLng = position.coords.longitude;
        const userPos = { lat: userLat, lng: userLng };
        map.setCenter(userPos);
        marker.setPosition(userPos);
        latInput.value = userLat;
        lngInput.value = userLng;
      }, function() {
        console.log("Geolocation permission denied or timed out.");
      });
    }
  }

  function toggleDeliveryType(type) {
    const cardDelivery = document.getElementById('card-delivery-type-delivery');
    const cardPickup = document.getElementById('card-delivery-type-pickup');
    const addressSection = document.getElementById('address-section');
    const pickupBox = document.getElementById('pickup-locations-box');
    const deliveryInfoBox = document.getElementById('delivery-info-box');
    
    // Inputs to toggle required attribute
    const streetInput = document.getElementById('street');
    const provinceSelect = document.getElementById('province');
    const cityInput = document.getElementById('city');
    const zipInput = document.getElementById('zipCode');

    if (type === 'pickup') {
      cardPickup.classList.add('border-brand-500', 'bg-brand-50/20');
      cardPickup.classList.remove('border-slate-200');
      cardPickup.querySelector('i').classList.replace('text-slate-400', 'text-brand-605');

      cardDelivery.classList.remove('border-brand-500', 'bg-brand-50/20');
      cardDelivery.classList.add('border-slate-200');
      cardDelivery.querySelector('i').classList.replace('text-brand-605', 'text-slate-400');

      addressSection.classList.add('hidden');
      pickupBox.classList.remove('hidden');
      deliveryInfoBox.classList.add('hidden');

      streetInput.removeAttribute('required');
      provinceSelect.removeAttribute('required');
      cityInput.removeAttribute('required');
      zipInput.removeAttribute('required');
    } else {
      cardDelivery.classList.add('border-brand-500', 'bg-brand-50/20');
      cardDelivery.classList.remove('border-slate-200');
      cardDelivery.querySelector('i').classList.replace('text-slate-400', 'text-brand-605');

      cardPickup.classList.remove('border-brand-500', 'bg-brand-50/20');
      cardPickup.classList.add('border-slate-200');
      cardPickup.querySelector('i').classList.replace('text-brand-605', 'text-slate-400');

      addressSection.classList.remove('hidden');
      pickupBox.classList.add('hidden');
      deliveryInfoBox.classList.remove('hidden');

      streetInput.setAttribute('required', 'required');
      provinceSelect.setAttribute('required', 'required');
      cityInput.setAttribute('required', 'required');
      zipInput.setAttribute('required', 'required');
      
      // Trigger google map resize in case it was hidden and is now shown
      if (typeof google !== 'undefined' && google.maps && map) {
        google.maps.event.trigger(map, 'resize');
      }
    }
  }

  function formatPriceJS(val) {
    return new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(val);
  }

  let appliedDiscountAmount = 0;
  let currentPaymentMethod = 'mercadopago';

  function updateOrderTotals() {
    const discountedSubtotal = baseTotal - appliedDiscountAmount;
    
    // Update Subtotal element
    const subtotalEl = document.getElementById('summary-subtotal');
    if (subtotalEl) {
      subtotalEl.textContent = formatPriceJS(baseTotal);
    }
    
    // Update Discount row
    const discountRow = document.getElementById('discount-row');
    const discountAmountEl = document.getElementById('discount-amount');
    if (appliedDiscountAmount > 0) {
      discountRow.classList.remove('hidden');
      discountAmountEl.textContent = `-${formatPriceJS(appliedDiscountAmount)}`;
    } else {
      discountRow.classList.add('hidden');
    }

    // Calculate Platform fee (5%) and Payment Gateway fee (15% only for Mercado Pago) on the discounted subtotal
    const isMp = currentPaymentMethod === 'mercadopago';
    const platformFee = discountedSubtotal * 0.05;
    const gatewayFee = isMp ? (discountedSubtotal * 0.15) : 0;
    const finalTotal = discountedSubtotal + platformFee + gatewayFee;

    // Update Platform fee elements
    const platformFeeRow = document.getElementById('platform-fee-row');
    const platformFeeAmountSpan = document.getElementById('platform-fee-amount');
    if (platformFeeAmountSpan) {
      platformFeeAmountSpan.textContent = `+ ` + formatPriceJS(platformFee);
    }
    if (platformFeeRow) {
      platformFeeRow.classList.remove('hidden');
    }

    // Update Gateway fee elements
    const gatewayFeeRow = document.getElementById('gateway-fee-row');
    const gatewayFeeAmountSpan = document.getElementById('gateway-fee-amount');
    if (gatewayFeeAmountSpan) {
      gatewayFeeAmountSpan.textContent = `+ ` + formatPriceJS(gatewayFee);
    }
    if (gatewayFeeRow) {
      if (isMp) {
        gatewayFeeRow.classList.remove('hidden');
      } else {
        gatewayFeeRow.classList.add('hidden');
      }
    }

    // Update Grand Total element
    const summaryTotalSpan = document.getElementById('summary-total');
    if (summaryTotalSpan) {
      summaryTotalSpan.textContent = formatPriceJS(finalTotal);
    }
  }

  async function applyCoupon() {
    const input = document.getElementById('coupon-input');
    const messageEl = document.getElementById('coupon-message');
    const hiddenInput = document.getElementById('hidden-coupon-code');
    
    const code = input.value.trim().toUpperCase();
    if (!code) {
      messageEl.textContent = 'Por favor ingresa un código.';
      messageEl.className = 'text-[10.5px] font-semibold text-rose-600';
      messageEl.classList.remove('hidden');
      return;
    }

    try {
      const response = await fetch('/api/coupons/apply', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ code })
      });

      const result = await response.json();
      if (result.success) {
        appliedDiscountAmount = result.discountAmount;
        hiddenInput.value = code;
        
        messageEl.textContent = `Cupón "${code}" aplicado con éxito. Descuento: -${formatPriceJS(result.discountAmount)}`;
        messageEl.className = 'text-[10.5px] font-semibold text-emerald-600';
        messageEl.classList.remove('hidden');
      } else {
        appliedDiscountAmount = 0;
        hiddenInput.value = '';
        
        messageEl.textContent = result.message || 'Error al aplicar cupón.';
        messageEl.className = 'text-[10.5px] font-semibold text-rose-600';
        messageEl.classList.remove('hidden');
      }
      updateOrderTotals();
    } catch (err) {
      console.error(err);
      messageEl.textContent = 'Error de conexión con el servidor.';
      messageEl.className = 'text-[10.5px] font-semibold text-rose-600';
      messageEl.classList.remove('hidden');
    }
  }

  function togglePaymentMethod(method) {
    currentPaymentMethod = method;
    const cardMp = document.getElementById('card-mp');
    const cardTransfer = document.getElementById('card-transfer');
    const instructions = document.getElementById('transfer-instructions');
    const receiptInput = document.getElementById('receipt');
    
    const secureInfoBox = document.getElementById('secure-info-box');

    if (method === 'transfer') {
      cardTransfer.classList.add('border-brand-500', 'bg-brand-50/20');
      cardTransfer.classList.remove('border-slate-200');
      cardTransfer.querySelector('i').classList.replace('text-slate-400', 'text-brand-600');
      
      cardMp.classList.remove('border-brand-500', 'bg-brand-50/20');
      cardMp.classList.add('border-slate-200');
      
      instructions.classList.remove('hidden');
      receiptInput.setAttribute('required', 'required');

      // Update Info box text
      secureInfoBox.innerHTML = '<i class="fa-solid fa-clock text-indigo-600 text-base mt-0.5"></i><span>Una vez realizado el pago de transferencia, recuerda <strong>subir la captura del comprobante</strong> de pago para que el administrador valide tu compra.</span>';
    } else {
      cardMp.classList.add('border-brand-500', 'bg-brand-50/20');
      cardMp.classList.remove('border-slate-200');
      
      cardTransfer.classList.remove('border-brand-500', 'bg-brand-50/20');
      cardTransfer.classList.add('border-slate-200');
      cardTransfer.querySelector('i').classList.replace('text-brand-600', 'text-slate-400');
      
      instructions.classList.add('hidden');
      receiptInput.removeAttribute('required');

      // Update Info box text
      secureInfoBox.innerHTML = '<i class="fa-solid fa-shield-halved text-brand-600 text-base mt-0.5"></i><span>Serás redirigido a <strong>MercadoPago</strong> de forma 100% segura para abonar tu orden. Aceptamos tarjetas de débito/crédito y dinero en cuenta.</span>';
    }
    updateOrderTotals();
  }

  window.onload = function() {
    // Set minimum date to today
    const dateInput = document.getElementById('scheduledDate');
    if (dateInput) {
      const today = new Date().toISOString().split('T')[0];
      dateInput.min = today;
    }
    
    // Initialize default payment method and delivery type selection
    togglePaymentMethod('mercadopago');
    toggleDeliveryType('delivery');
  };
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCBMrNLZp5utwO_ecNIxd2srSxU_LWE2OA&libraries=places&callback=initMap" async defer></script>

<%- include('../partials/footer') %>
